generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Where a client-originated document is read (issue #21, stories 91 and 92).
///
/// A database enum and not ADR-0031's text-with-a-CHECK: both members name
/// themselves and neither carries a character a Prisma enum member cannot, so
/// ADR-0036's reasoning applies unchanged.
///
/// `LOCAL` does not name a second implementation. There is no local OCR in
/// this product and the `OcrProvider` port takes no project, so the setting is
/// a *permission* and not a selector: LOCAL means the port is never called and
/// manual entry is the path (ADR-0044).
enum ProcessingLocation {
  LOCAL
  CLOUD

  @@map("processing_location")
}

/// The record everything else in this product hangs off (issue #3). There is
/// no owner, no tenant and no user: see ADR-0012.
///
/// Neither timestamp has a `@default(now())`. The database must not be able to
/// supply a domain-meaningful time, so that the value can only come from the
/// injected TimeSource at the API boundary (ADR-0022).
model Project {
  id String @id @default(uuid())

  /// The short local identifier — "T-1" — carried into the vault, into
  /// conversation and into email so one job is referred to the same way
  /// everywhere. Unique, and nothing writes it after creation: the API
  /// exposes no route that updates a project.
  projectNumber String @unique @map("project_number")

  name      String
  createdAt DateTime @map("created_at")

  /// When the job finished. Null is the live state; archiving stamps it once
  /// and never restamps, so the record survives and drops out of the list
  /// without being deleted. There is no unarchive.
  archivedAt DateTime? @map("archived_at")

  /// The phase a new submission defaults to (issue #5). This is the first
  /// column any route updates on a project; the project *number* is what the
  /// glossary makes immutable, and it still is (ADR-0026).
  currentPhaseId String?       @map("current_phase_id")
  currentPhase   ProjectPhase? @relation("CurrentPhase", fields: [currentPhaseId], references: [id])

  /// How many issue identifiers this project has handed out (issue #10).
  ///
  /// A high-water mark and never a count of the rows: it only ever increases,
  /// so a number is handed out once and never again — not after an issue is
  /// closed, and not after one is deleted, which `MAX(number) + 1` could not
  /// promise. That is the whole of story 59, and the reason a reference
  /// printed in an issued report stays valid forever.
  issuesAllocated Int @default(0) @map("issues_allocated")

  /// The secret half of this job's forward-to-ingest address (issue #19,
  /// stories 82 and 83). Twenty-four random bytes, base64url, written in the
  /// same statement as the project.
  ///
  /// Deliberately NOT the project number, which ADR-0009 sketched as
  /// `rfi+{project-key}@ingest.{domain}`. That phrasing is struck vocabulary
  /// and, worse, an address built from `T-1` is guessable off any document
  /// header — and story 83 asks for unguessable. This token shares nothing
  /// with any identifier the engineer writes down (ADR-0042).
  ///
  /// Never on the wire by itself: the API returns the composed
  /// `ingestAddress`, or null where no domain is configured.
  ingestToken String @unique @map("ingest_token")

  /// Where this job's client-originated documents are read (issue #21,
  /// story 91). Defaults to `CLOUD`: ADR-0013 rejected local-first on
  /// operational grounds and is the qualifier ADR-0008 itself names, which
  /// ADR-0044 settles against the glossary's opposite reading.
  ///
  /// Read at both extraction create routes and again in the worker before any
  /// bytes are fetched. Both matter, for ADR-0042's reason: the first gives
  /// the engineer an answer, the second is what makes the setting a bound on
  /// a job already sitting in Redis when consent is withdrawn.
  processingLocation ProcessingLocation @default(CLOUD) @map("processing_location")

  /// What the firm signed, and when they signed it (issue #21, story 92) —
  /// consent as a recorded fact rather than a recollection.
  ///
  /// Both null or both set, held by a CHECK, which is ADR-0024's shape for
  /// `resolved_at` and ADR-0031's for a closure. What a CHECK deliberately
  /// cannot hold here is "cloud implies a sign-off": under a cloud default a
  /// project reaches `CLOUD` without ever having been switched, so that
  /// invariant is false by design and only the route can gate the switch
  /// (ADR-0044).
  ///
  /// The instant is supplied and never read from the TimeSource, the frame
  /// `held_since` uses: a sign-off letter dated last Tuesday and recorded
  /// today is dated when it was signed. When the switch happened is the audit
  /// entry's `created_at`, which is the TimeSource's.
  cloudSignoffReference String?   @map("cloud_signoff_reference")
  cloudSignoffAt        DateTime? @map("cloud_signoff_at")

  phases      ProjectPhase[] @relation("ProjectPhases")
  submissions Submission[]
  siteVisits  SiteVisit[]
  issues      Issue[]

  /// The two correspondence logs, written with the project and never
  /// afterwards (issue #14). Both always exist: see `Register`.
  registers Register[]

  /// What has been stored against this job (issue #17). Retrieval is by
  /// identity — this project, this submission, this entry — and never by
  /// similarity to a query (ADR-0019).
  documents Document[]

  /// What has arrived from outside and not yet been read (issue #19). Raw
  /// arrivals, deliberately not `Document`s: a message carries no title, no
  /// revision and no referenced-file answer, and all three are extraction's
  /// to propose and the engineer's to confirm (ADR-0042).
  ingestedDocuments IngestedDocument[]

  /// The curated prose and its history (issue #18): every state the memory
  /// has been in, every edit the agent has proposed, every run, and the
  /// audit of all of it.
  memoryVersions  ProjectMemoryVersion[]
  memoryProposals MemoryProposal[]
  agentRuns       AgentRun[]
  auditEntries    AuditEntry[]

  /// The extractions asked for on this job (issue #20): one row per run,
  /// whether its source was an arrival's file or a stored document's version.
  extractions RegisterEntryExtraction[]

  @@map("projects")
}

/// A named stage of design progress, defined per project and editable as free
/// text — "50% CD", "90% CD", "Building Permit Set" (ADR-0015, glossary).
///
/// Rows on a project and never an enum: some jobs run 50% CD and others go
/// straight to 90% CD, so there is no set to share across them.
model ProjectPhase {
  id String @id @default(uuid())

  projectId String  @map("project_id")
  project   Project @relation("ProjectPhases", fields: [projectId], references: [id])

  name String

  /// Contiguous from zero. Reordering rewrites the whole list in one
  /// transaction, so the route is the only writer and positions cannot drift
  /// into gaps or duplicates. Deliberately not a unique constraint: a
  /// non-deferrable one would reject the reorder mid-flight (ADR-0026).
  position Int

  submissions Submission[]
  currentFor  Project[]    @relation("CurrentPhase")

  @@unique([projectId, name])
  @@index([projectId, position])
  @@map("project_phases")
}

/// A dated issuance of a defined set to a named recipient at a phase
/// (ADR-0015, issue #5).
///
/// Never edited. There is no route that updates one, which is what makes
/// issue #7's "no path edits an issued submission" true by construction
/// rather than by a guard that can be forgotten. A correction is a reissue
/// that supersedes, and `supersedes_id` arrives with it.
model Submission {
  id String @id @default(uuid())

  projectId String  @map("project_id")
  project   Project @relation(fields: [projectId], references: [id])

  /// A foreign key, not a copied string: renaming a phase is the same body of
  /// work under a better name, so it propagates to what was issued at it. A
  /// different stage is a different phase (ADR-0026).
  phaseId String       @map("phase_id")
  phase   ProjectPhase @relation(fields: [phaseId], references: [id])

  /// When the set went out. Settable, because the issuances worth entering
  /// first went out long before this row existed; otherwise the injected
  /// TimeSource, and never a database default (ADR-0022).
  issuedAt DateTime @map("issued_at")

  /// Who it went to, and in what capacity — "the EOR", "the client". Both
  /// free text: there is no `users` table (ADR-0012), and the corpus names
  /// two example roles rather than a closed set.
  recipient     String
  recipientRole String @map("recipient_role")

  /// What distinguishes successive issuances of the same set: "A", "Rev 2".
  revision String

  /// The defined set, one sheet per line. Text rather than rows — ADR-0026
  /// records what that buys and the one thing it defers.
  sheetList String @map("sheet_list")

  /// Entry order, so two sets issued on the same day do not list at random.
  createdAt DateTime @map("created_at")

  /// Whether the set went out on unconfirmed inputs — true when any open item
  /// it was issued resting on was unresolved at that moment (issue #6).
  ///
  /// Stamped once by the create route and never recomputed: resolving those
  /// items afterwards answers the inputs, it does not change what the set
  /// went out on. *Currently* provisional is the other fact, derived from
  /// `openItems` on every read and never stored — a single column would have
  /// to lie about one of the two the moment an item resolved.
  ///
  /// No `@default`, for the reason the timestamps have none: only the route
  /// may supply it, or a caller could claim a set went out clean.
  issuedProvisional Boolean @map("issued_provisional")

  /// The issuance this one replaces (issue #7). Correcting the record is a
  /// reissue that supersedes, never an edit, so the arrow points backwards
  /// from the successor and the row it points at is not touched.
  ///
  /// Unique, which is the whole of "at most one successor": a second reissue
  /// of the same predecessor is refused by the database rather than by a
  /// guard that can be forgotten, and the chain is therefore linear. Cycles
  /// cannot arise — a row is created already pointing at an older one, and
  /// nothing ever repoints it.
  ///
  /// *Superseded* has no column. It is a successor existing, derived on every
  /// read, for the reason `currently provisional` is derived (ADR-0027): a
  /// stored flag would be a second place for the same fact to be wrong.
  supersedesId String?     @unique @map("supersedes_id")
  supersedes   Submission? @relation("Supersede", fields: [supersedesId], references: [id], onDelete: Restrict)
  supersededBy Submission? @relation("Supersede")

  openItems         SubmissionOpenItem[]
  assumptionRecords AssumptionRecord[]

  /// The register entries this issuance responded to (story 81). The arrow
  /// points from the entry, so linking one writes nothing here — which is
  /// what keeps "no route updates a submission" true (ADR-0026).
  respondsTo RegisterEntry[]

  /// The document versions this issuance's sheet list points at (story 95).
  ///
  /// A join and never a column here, for the reason `supersedes_id` points
  /// backwards and `register_entries.submission_id` points inwards: a column
  /// on this table could only be written after the set went out, and no route
  /// updates a submission (ADR-0026).
  documentVersions SubmissionDocumentVersion[]

  @@index([projectId, issuedAt])
  @@map("submissions")
}

/// What an issuance rests on (ADR-0026).
///
/// An open item's own `subject_type`/`subject_id` says where it lives; this
/// says which issuances depended on it. They are different relations, and
/// this one is many-to-many: one unconfirmed input that several sets went
/// out on is a single record, not one copy per set that rested on it.
///
/// `unresolved_at_issuance` is issue #6's snapshot of what was unresolved at
/// that moment. Issue #7's carry-forward is an insert against the successor,
/// which leaves the superseded submission's rows untouched — the reason this
/// is a join table and not a second subject.
model SubmissionOpenItem {
  submissionId String     @map("submission_id")
  submission   Submission @relation(fields: [submissionId], references: [id])

  openItemId String   @map("open_item_id")
  openItem   OpenItem @relation(fields: [openItemId], references: [id])

  /// Where this item stood at the moment the set went out (issue #6). Null is
  /// an item attached afterwards, which was no part of the issuance and is
  /// therefore the only kind that may be detached again — deleting a row of
  /// the snapshot would be the erasure by cleanup ADR-0026 flagged.
  unresolvedAtIssuance Boolean? @map("unresolved_at_issuance")

  @@id([submissionId, openItemId])
  @@index([openItemId])
  @@map("submission_open_items")
}

/// The set of artifacts an open item can hang off. ADR-0014 says "any
/// artifact"; only projects exist so far, so this carries one value and
/// adding a second is a migration rather than a new free-text string.
enum OpenItemSubject {
  PROJECT

  @@map("open_item_subject")
}

/// The central record of the product (ADR-0014, issue #4): an unresolved
/// dependency attached to an artifact.
///
/// "Pending items" is a *view* over these rows, never a second table.
///
/// The subject is polymorphic — type plus id — so there is no foreign key to
/// `projects`; the route checks the subject exists before writing.
model OpenItem {
  id String @id @default(uuid())

  subjectType OpenItemSubject @map("subject_type")
  subjectId   String          @map("subject_id")

  /// What is unresolved. The PRD's data-model sketch has no column for it,
  /// but ADR-0014 and the glossary both make it the first thing an open item
  /// records, so it is named here for the spec's own word.
  unresolved String

  /// What it blocks — the reason this is worth chasing.
  blocks String

  /// Who owes the next move. Null is nobody, which ADR-0014 calls out as a
  /// real answer; the API rejects a blank one, so nobody is only ever said on
  /// purpose and never arrived at by leaving a field empty.
  waitingOn String? @map("waiting_on")

  /// Since when. Aged by the pending items view, so it comes from the
  /// injected TimeSource or from the engineer backdating an item that has
  /// been open for months — never from a database default (ADR-0022).
  waitingSince DateTime @map("waiting_since")

  /// The event that makes a recorded result false without anything being
  /// unresolved. A field, not its own record type (glossary, ADR-0014).
  invalidationTrigger String? @map("invalidation_trigger")

  /// What changes if the assumption turns out wrong. Required: the glossary
  /// calls it the field that carries the engineering value.
  counterfactual String

  /// The internal person the item sits with — the author, or an E1 on the
  /// occasional delegated task. Plain text: there is no `users` table
  /// (ADR-0012), and this is a different person from `waitingOn`.
  owner String?

  /// Resolution is these two together: both null while unresolved, both set
  /// once resolved, and reopening clears both. Exposure and provisional state
  /// (issues #6, #16) are derived from `resolvedAt` being null.
  resolvedAt     DateTime? @map("resolved_at")
  resolutionNote String?   @map("resolution_note")

  /// The issuances resting on this item. Not the subject — see ADR-0026.
  submissions SubmissionOpenItem[]

  /// The `FLAGS / VERIFY` line this item was raised from, if it was raised
  /// from one at all (issue #8). Most open items are typed by hand and have
  /// none.
  raisedFrom RaisedFlag?

  /// The findings this item is being chased for (issue #10). Not the subject —
  /// see ADR-0026, and the same reasoning as `submissions` above.
  issues IssueOpenItem[]

  /// The register entries this item is being chased for (story 79). Not the
  /// subject either, for the third time and for ADR-0031's reasons.
  registerEntries RegisterEntryOpenItem[]

  @@index([subjectType, subjectId])
  @@map("open_items")
}

/// The durable artifact of engineering reasoning (issue #8, glossary): the
/// `ASSUMPTIONS` block and the `FLAGS / VERIFY` block captured verbatim from a
/// helper skill's output, bound to the submission they justified, with the
/// code edition and the date.
///
/// The arithmetic is reproducible without this; the reasoning is not. Nothing
/// here reimplements a helper skill's math — this records what one produced.
///
/// Never edited, for the reason a submission is not: it is a capture of what
/// something else output at a moment. Running the calculation again produces
/// another record against the submission, dated its own day, and the two sit
/// side by side.
model AssumptionRecord {
  id String @id @default(uuid())

  /// The issuance this reasoning justified. A foreign key and not a
  /// polymorphic subject: the glossary binds an assumption record to a
  /// submission and to nothing else. The sketch in the PRD has no such column
  /// at all, which is one of the things ADR-0029 settles.
  submissionId String     @map("submission_id")
  submission   Submission @relation(fields: [submissionId], references: [id])

  /// The two blocks, verbatim. Held as text with nothing trimmed, normalised
  /// or re-wrapped: "captured verbatim" is the whole point, and a block that
  /// came back re-indented would no longer be what the helper skill produced.
  ///
  /// Each carries one entry per line — an assumed input, or a flag to verify.
  /// That is not a format this parses for: it is how the entries are
  /// addressed, and a line that is neither is simply a line nothing points at.
  assumptions String
  flags       String

  /// Which editions the reasoning was done against — "NEC 2023", or the five
  /// standards the generator sizer works to at once. One free-text field
  /// rather than a set: it is a list an engineer writes, and it cannot be read
  /// out of the blocks, which never name it.
  codeEdition String @map("code_edition")

  /// The date of the calculation this captures — the sketch's "dated".
  /// Settable, because the reasoning worth entering first was done long
  /// before this row existed; otherwise the injected TimeSource, and never a
  /// database default (ADR-0022).
  calculatedAt DateTime @map("calculated_at")

  /// Entry order, so two captures dated the same day do not list at random.
  createdAt DateTime @map("created_at")

  counterfactuals Counterfactual[]
  raisedFlags     RaisedFlag[]

  @@index([submissionId, calculatedAt])
  @@map("assumption_records")
}

/// What changes if one assumed input turns out wrong (story 39, glossary).
///
/// The sketch in the PRD names `counterfactuals` as a column. It is rows,
/// because the spec asks for one per assumed input and a single field could
/// not say which input each belongs to.
///
/// The input is a *line number*, not a copy of the text. The block is captured
/// verbatim and never edited, so the line is a stable pointer, and there is
/// therefore only one place the wording of an assumption can be wrong.
model Counterfactual {
  assumptionRecordId String           @map("assumption_record_id")
  assumptionRecord   AssumptionRecord @relation(fields: [assumptionRecordId], references: [id])

  /// Zero-based index into the lines of `assumption_records.assumptions`.
  line Int

  /// Capped at 1000 like the open item's, being the same field on the other
  /// record the glossary requires it on.
  counterfactual String

  @@id([assumptionRecordId, line])
  @@map("counterfactuals")
}

/// A line of a record's `FLAGS / VERIFY` block that has been raised as an open
/// item (issue #8, story 40), so a flag raised during a calculation cannot be
/// raised and then forgotten.
///
/// Addressed by line for the reason a counterfactual is.
///
/// A flag has no state of its own. It is outstanding until it is raised, and
/// after that the open item's `resolved_at` is the whole of whether it is
/// still outstanding — ADR-0024's one column, not a second beside it.
model RaisedFlag {
  assumptionRecordId String           @map("assumption_record_id")
  assumptionRecord   AssumptionRecord @relation(fields: [assumptionRecordId], references: [id])

  /// Zero-based index into the lines of `assumption_records.flags`.
  line Int

  /// The item this flag became. Unique, which is the whole of "one flag, at
  /// most one open item, and no item is two flags": raising the same flag
  /// twice is refused by the database rather than by a guard that can be
  /// forgotten.
  openItemId String   @unique @map("open_item_id")
  openItem   OpenItem @relation(fields: [openItemId], references: [id])

  @@id([assumptionRecordId, line])
  @@map("raised_flags")
}

/// One dated observation event against a building (issue #9, glossary): a walk,
/// with a start, an end, and a per-floor schedule of when each floor was
/// started and completed.
///
/// It produces observations; it does not own their content. Where an
/// observation was made is the observation's own location, and this record
/// says only when the engineer was where.
///
/// Not an *inspection*: the glossary's `_Avoid_` list strikes that word because
/// it implies an authority-having-jurisdiction role that is not ours, and
/// strikes *walkthrough* with it. "Walk" is what the act is called in prose;
/// the record is a site visit.
model SiteVisit {
  id String @id @default(uuid())

  projectId String  @map("project_id")
  project   Project @relation(fields: [projectId], references: [id])

  /// When the walk began. Settable, because the visits worth entering first
  /// happened long before this row existed; otherwise the injected TimeSource,
  /// and never a database default (ADR-0022).
  startedAt DateTime @map("started_at")

  /// When it ended, or null while it is still under way. Nullable because the
  /// per-floor schedule is recorded *during* the visit (story 50), so a walk
  /// has to be able to exist before it is over — `POST /v1/site-visits/:id/end`
  /// stamps it once and refuses a second time.
  ///
  /// The visit's **date** is the day of `started_at`, derived on every read and
  /// stored nowhere. A `visited_on` column would be a second place for the same
  /// fact to be wrong (ADR-0027's shape, applied here).
  endedAt DateTime? @map("ended_at")

  /// Entry order, so two visits started the same day do not list at random.
  createdAt DateTime @map("created_at")

  floors        SiteVisitFloor[]
  observations  Observation[]
  photos        Photo[]
  voiceCaptures VoiceCapture[]
  reports       SiteVisitReport[]

  @@index([projectId, startedAt])
  @@map("site_visits")
}

/// One floor's entry in a visit's schedule: when it was started and when it was
/// completed (story 50).
///
/// This exists so that every photo taken between those two stamps can be
/// attributed to that floor without each one being labelled by hand (issue #11).
/// That is the whole of its job — it is a window in time, not a location.
///
/// One row per floor per visit. Starting the same floor twice on one walk is
/// refused by the unique constraint rather than by a guard that can be
/// forgotten, which is the shape `supersedes_id` and `raised_flags.open_item_id`
/// already have.
model SiteVisitFloor {
  id String @id @default(uuid())

  siteVisitId String    @map("site_visit_id")
  siteVisit   SiteVisit @relation(fields: [siteVisitId], references: [id])

  /// The floor designation, without the word "Floor" — "3", "B1", "M", "PH".
  /// Free text and not an integer: the grammar writes `Floor N`, but real
  /// buildings have basements, mezzanines and penthouses, and an integer column
  /// could not record an observation made in any of them (ADR-0030).
  ///
  /// The same type as `observations.floor`, deliberately, so a later slice can
  /// bin a photo to a floor and find the observations made on it.
  floor String

  /// When the engineer arrived on this floor, and when they left it. The
  /// completion is null while the floor is still being walked.
  startedAt   DateTime  @map("started_at")
  completedAt DateTime? @map("completed_at")

  @@unique([siteVisitId, floor])
  @@map("site_visit_floors")
}

/// Something recorded during a site visit at a specific location and time
/// (issue #9, glossary).
///
/// **Most observations are not findings.** The "Notable Observations
/// (Non-Issues)" table is the majority case, so staying an observation is the
/// default path and there is nothing on this row that makes one a finding.
/// Becoming an **issue** is ticket #10's deliberate exception, and it arrives as
/// a row pointing at this one rather than as a status column here.
///
/// Bound to the visit that produced it and to nothing else. The project is the
/// visit's, read through it, for the reason an assumption record reads its
/// project through its submission.
model Observation {
  id String @id @default(uuid())

  siteVisitId String    @map("site_visit_id")
  siteVisit   SiteVisit @relation(fields: [siteVisitId], references: [id])

  /// What was observed. Named for the domain word the way an open item's
  /// `unresolved` is, and deliberately not `note`: the glossary's `_Avoid_`
  /// list strikes that word for this record, because a note is something you
  /// jot beside a thing and this *is* the thing.
  observed String

  /// When it was observed. Settable, and otherwise the injected TimeSource:
  /// this is the stamp issue #11 bins photographs against, so it must be the
  /// real moment and never the moment the row was written.
  observedAt DateTime @map("observed_at")

  /// The location, stored as the components of the grammar rather than as the
  /// composed string: `Floor N — <qualifier>, <Side|Sector>` (glossary).
  ///
  /// The rendered string is derived on every read and stored nowhere, so the
  /// components and the string cannot come to disagree — the shape ADR-0027 and
  /// ADR-0028 gave *currently provisional* and *superseded*.
  ///
  /// The qualifier is free text on purpose: the glossary admits five kinds of
  /// reference — a landmark, a room number with a type gloss, a circulation
  /// element, a program space, or an equipment tag — and a column that could
  /// hold only one of them would force the field to match the tool.
  floor     String
  qualifier String

  /// Side (A/B, the building halves) and Sector (a finer zone) are independent
  /// axes and **never combine in one string**. Exactly one is set: both is
  /// refused, and neither is refused too, because the grammar has no optional
  /// segment for the interface to leave empty (story 55, ADR-0030).
  ///
  /// Enforced by a CHECK constraint in the migration as well as by the route.
  /// Prisma's schema language cannot express one, so it is written by hand
  /// there and named here; three more routes will write this table (#10's
  /// re-observation, #12's draft from a transcript) and each of them would
  /// otherwise have to remember.
  side   String?
  sector String?

  /// Entry order, so two observations at the same minute do not list at random.
  createdAt DateTime @map("created_at")

  /// The findings this observation is one sighting of (issue #10). Nothing
  /// here says whether there are any: promotion is a row pointing back at this
  /// one, which is what keeps staying an observation the default path.
  issues IssueObservation[]

  /// The recording this observation was committed from, if it was spoken
  /// rather than typed (issue #12). Nothing here says whether there is one:
  /// the capture points at this row and this row is written no differently,
  /// which is what keeps typing and speaking the same record.
  voiceCapture VoiceCapture?

  @@index([siteVisitId, observedAt])
  @@map("observations")
}

/// A project-scoped **finding** with a stable identifier that survives the
/// report it first appeared in (issue #10, glossary).
///
/// This is the record the five findings of 2026-07-23 never had: written up
/// with recommended actions, and nothing tracking whether any of them closed.
///
/// It owns no content of its own. What was seen, when and where is the
/// observation's, and an issue re-observed on three walks has three of them —
/// so there is no summary column here and no location, which the PRD's sketch
/// named. Story 67 prints "the issues with their categories, locations": the
/// location is read through the observations, the way an assumption record
/// reads its project through its submission.
///
/// *Finding* is the right word for it and for nothing else. The glossary's
/// `_Avoid_` list reserves the word for an observation that has become an
/// issue, and strikes *defect*, *deficiency*, *punch item* and *RFI* — only a
/// minority of issues ever become RFIs.
model Issue {
  id String @id @default(uuid())

  projectId String  @map("project_id")
  project   Project @relation(fields: [projectId], references: [id])

  /// The stable identifier, scoped to the project and allocated from
  /// `projects.issues_allocated` at creation (stories 58, 59).
  ///
  /// The integer and nothing else. How it prints in a report is issue #13's
  /// and how it appears in a photograph's filename is issue #11's, and neither
  /// has seen the real filenames yet — inventing `T-1-003` here would be a
  /// format those tickets then have to match rather than choose.
  ///
  /// Unique per project, which is what makes "never renumbered" a fact the
  /// database keeps rather than a guard that can be forgotten. No route
  /// updates it: there is no PATCH on an issue at all.
  number Int

  /// One of exactly five, in the words the glossary writes them:
  /// `Accessibility`, `Physical / Safety`, `Functional`, `Safety / Code`,
  /// `Design / Coordination` (story 60).
  ///
  /// Text with a CHECK constraint rather than a database enum, because a
  /// Prisma enum member cannot be named `Physical / Safety` and would put a
  /// `PHYSICAL_SAFETY` on the wire with the real words in a lookup beside it —
  /// the second place the same fact lives that ADR-0024 refuses. The closed
  /// set is enforced by the body schema *and* by the CHECK, the shape
  /// ADR-0030 gave the one-axis rule; the constraint is written by hand in the
  /// migration, since Prisma's schema language cannot express one.
  category String

  /// The lifecycle the five findings never had: both null while the issue is
  /// open, both set once it is closed, and reopening clears both.
  ///
  /// ADR-0024's shape exactly, and for its reasons: a status column would be a
  /// second place the same fact lives, and there is no history of closings
  /// because the observations are the history — "still there on the second
  /// walk" is a re-observation row, not a state transition (story 61).
  closedAt    DateTime? @map("closed_at")
  closureNote String?   @map("closure_note")

  /// Entry order, so two issues raised on the same walk do not list at random.
  createdAt DateTime @map("created_at")

  observations IssueObservation[]
  openItems    IssueOpenItem[]
  photos       Photo[]

  @@unique([projectId, number])
  @@map("issues")
}

/// One sighting of a finding: the observation it was raised from, and every
/// later observation of the same thing (story 61).
///
/// A row pointing at the observation and never a column on it. ADR-0030 is
/// explicit that becoming an issue "will arrive as a row pointing at the
/// observation, not as a column here", and a test asserts the exact key set an
/// observation returns — so the shape is `raised_flags`', which is a row for
/// the same reason.
model IssueObservation {
  issueId String @map("issue_id")
  issue   Issue  @relation(fields: [issueId], references: [id])

  /// Unique, which is the whole of "one observation, at most one issue": the
  /// database refuses a second promotion of the same sighting rather than a
  /// guard that can be forgotten, exactly as `raised_flags.open_item_id` and
  /// `submissions.supersedes_id` do.
  ///
  /// It matters more here than there. Identifiers are never reused, so a
  /// double-tap that promoted twice would burn a number on a duplicate and
  /// leave the record permanently one issue heavier.
  ///
  /// Two problems seen in one place are two observations, not one observation
  /// on two findings.
  observationId String      @unique @map("observation_id")
  observation   Observation @relation(fields: [observationId], references: [id])

  @@id([issueId, observationId])
  @@map("issue_observations")
}

/// An open item being chased for a finding (story 69).
///
/// A join, not a subject. The item's `subject_type` stays `PROJECT` and its
/// `subject_id` stays the job, so it is on the project screen and reaches the
/// pending items view carrying the job it is on — which is what story 69 asks
/// for and what ADR-0026 recorded the subject reading would cost.
model IssueOpenItem {
  issueId String @map("issue_id")
  issue   Issue  @relation(fields: [issueId], references: [id])

  openItemId String   @map("open_item_id")
  openItem   OpenItem @relation(fields: [openItemId], references: [id])

  @@id([issueId, openItemId])
  @@index([openItemId])
  @@map("issue_open_items")
}

/// A photograph taken on a walk, bound to a floor by its timestamp and to a
/// finding by its filename (issue #11).
///
/// The bytes are **not here**. They go to the injected `ObjectStore` and this
/// row keeps the key, which is the ticket's own acceptance criterion and what
/// makes the same port serve issue #12's audio and step 5's documents.
///
/// Both bindings are stamped when the photograph is added and both are
/// correctable. Deliberately not derived on read, which is what this product
/// does with `location`, *currently provisional* and *superseded*: a derived
/// value has nowhere to keep a correction, and a schedule fixed the next
/// morning would silently move what was already binned.
model Photo {
  id String @id @default(uuid())

  /// The walk it was taken on, the way an observation is bound to its visit
  /// and to nothing else. The project is the visit's.
  siteVisitId String    @map("site_visit_id")
  siteVisit   SiteVisit @relation(fields: [siteVisitId], references: [id])

  /// The name the file arrived with, kept verbatim.
  ///
  /// Record content and not bookkeeping: the filename **is** the mechanism
  /// that binds a photograph to a finding (ADR-0018's "already in use"), so it
  /// is the one column here that a correction must never rewrite.
  ///
  /// Unique per visit, so re-adding the same hundred photographs after a
  /// signal drop is refused one at a time instead of doubling the walk.
  filename String

  /// When the photograph was taken, supplied by whoever adds it.
  ///
  /// Required, and pointedly **not** falling back to the injected TimeSource
  /// the way `observed_at` does: a photograph with no time would then bin to
  /// whichever floor was being walked at the moment of the request, which is
  /// the guess the ticket asks not to make. Nothing here reads EXIF — the
  /// product records the timestamp it is given.
  takenAt DateTime @map("taken_at")

  /// One of the image types the boundary admits, held so the bytes can be
  /// served back as what they are. A CHECK names the set, since the read route
  /// hands this straight to a browser.
  contentType String @map("content_type")

  /// What was stored, so a list can be rendered without reading every object.
  byteSize Int @map("byte_size")

  /// Where the bytes are in the object store. Stored rather than derived from
  /// the id, so the S3 adapter can key its objects however it likes without
  /// this table meaning something different than it did.
  storageKey String @unique @map("storage_key")

  /// The floor the timestamp binned it to, or null for a photograph no single
  /// window contained.
  ///
  /// The designation and not a foreign key to `site_visit_floors`, matching
  /// `observations.floor`: ADR-0030 joined those two by value precisely so a
  /// photograph's floor could sit beside the observations made on it, and a
  /// correction has to be able to name a floor nobody formally started.
  floor String?

  /// The finding the filename bound it to, or null for a name that matched no
  /// issue on this job.
  ///
  /// Binding here writes nothing to the issue and creates no **sighting**: a
  /// sighting is an observation (ADR-0031), and a filename is not one.
  issueId String? @map("issue_id")
  issue   Issue?  @relation(fields: [issueId], references: [id], onDelete: Restrict)

  /// Entry order, so two photographs taken in the same minute do not list at
  /// random.
  createdAt DateTime @map("created_at")

  @@unique([siteVisitId, filename])
  @@index([siteVisitId, takenAt])
  @@index([issueId])
  @@map("photos")
}

/// A recording made during a site visit, and the draft observation it becomes
/// (issue #12, stories 51-52).
///
/// The engineer speaks instead of typing, and what the vendor heard is reviewed
/// and corrected before anything becomes a record — so transcription error
/// never becomes record error.
///
/// **The draft is this row and not a state of an observation.** ADR-0030 put no
/// status on `observations`, no category and no promotion route, and a test
/// asserts the exact key set one comes back with; a `draft` column here would
/// be that status arriving under another name. Committing writes an ordinary
/// observation and stamps `observation_id` here, which is slice 9's shape —
/// promotion writes nothing at all to the row it points at.
///
/// The audio goes to the injected `ObjectStore` and never into the database,
/// the way a photograph's bytes do (ADR-0032); this row keeps the key.
model VoiceCapture {
  id String @id @default(uuid())

  /// The walk it was recorded on, the way an observation and a photograph are
  /// each bound to their visit and to nothing else. The project is the visit's.
  siteVisitId String    @map("site_visit_id")
  siteVisit   SiteVisit @relation(fields: [siteVisitId], references: [id])

  /// The name the phone gave this recording before it tried to send it, unique
  /// per visit.
  ///
  /// This is the whole of story 112: the recording is held on the phone until
  /// the server acknowledges it, and a send that is retried after the signal
  /// comes back carries the same key. A photograph reconciles on its filename
  /// (ADR-0032); a recording has no natural name, so the phone mints one.
  ///
  /// Unlike the photograph's, a repeat is answered with the row rather than
  /// refused: a refusal does not tell the phone whether the first attempt
  /// landed, and "without losing a recording" is what the story asks for.
  captureKey String @map("capture_key")

  /// When it was recorded, supplied by the phone that recorded it.
  ///
  /// Required, and never falling back to the injected TimeSource, for
  /// `photos.taken_at`'s reason: a recording sent an hour later when the signal
  /// returned would otherwise be stamped with the moment it arrived, and the
  /// observation it becomes is dated from this.
  recordedAt DateTime @map("recorded_at")

  /// One of the audio types the boundary admits, held so the bytes can be
  /// served back as what they are. A CHECK names the set, since the read route
  /// hands this straight to a browser.
  contentType String @map("content_type")

  /// What was stored, so a list renders without reading every object.
  byteSize Int @map("byte_size")

  /// Where the audio is in the object store. Never on the wire.
  storageKey String @unique @map("storage_key")

  /// The four stamps the state is read from. There is no status column, for
  /// ADR-0024's reason and ADR-0031's: `resolved_at` and `closed_at` are how
  /// this product says what has happened to a record, and a second answer
  /// beside them is a second thing to keep true.
  ///
  /// Queued is all four null. `transcribing_since` is stamped when the worker
  /// picks the job up; `transcript` and `transcribed_at` move together, as do
  /// `failed_at` and `failure`. Retrying clears the failure and the start, the
  /// way reopening an issue clears `closed_at` and `closure_note`.
  transcribingSince DateTime? @map("transcribing_since")
  transcript        String?
  transcribedAt     DateTime? @map("transcribed_at")
  failedAt          DateTime? @map("failed_at")

  /// Why the vendor could not transcribe it, in the vendor's own words. A
  /// failure and a rejection are the same stored fact: both leave the audio
  /// where it is, and nothing about what the engineer does next differs.
  failure String?

  /// The observation this draft became, or null while it is still a draft.
  ///
  /// Unique, so one recording becomes at most one observation — the shape
  /// `issue_observations.observation_id` has, and for its reason: a double tap
  /// that committed twice would write the same words into the record twice.
  ///
  /// The transcript above is **never rewritten** when the engineer corrects it.
  /// What the vendor heard and what was recorded are two facts, and keeping
  /// both is what makes "transcription error never became record error"
  /// something anybody can check afterwards (ADR-0029's verbatim shape).
  observationId String?      @unique @map("observation_id")
  /// `Restrict` named explicitly, because Prisma defaults an optional relation
  /// to `SetNull` while every foreign key in this schema is RESTRICT on delete.
  /// Left implicit, the next `migrate dev` would offer to rewrite this one and
  /// the two older ones that already differ.
  observation   Observation? @relation(fields: [observationId], references: [id], onDelete: Restrict)

  /// Entry order, so two recordings made in the same minute do not list at
  /// random.
  createdAt DateTime @map("created_at")

  @@unique([siteVisitId, captureKey])
  @@index([siteVisitId, recordedAt])
  @@map("voice_captures")
}

/// The write-up of a walk, rendered to PDF off the request (issue #13).
///
/// A **record of a rendering**, not a mutable document. Nothing here is
/// edited: generating again writes another row against the same visit, dated
/// its own moment, the way a rerun of a calculation is another assumption
/// record against the same submission (ADR-0029) and a correction to a
/// submission is a reissue (ADR-0028). That is also how a report is
/// regenerated after a missing photograph is added.
///
/// It owns no content. Everything it prints is read from the visit, its
/// observations, the findings sighted on it and their photographs at the
/// moment it renders — so a report cannot come to disagree with the record it
/// is a rendering of. What it froze is the PDF.
model SiteVisitReport {
  id String @id @default(uuid())

  /// The walk it is a write-up of. The project is the visit's, read through
  /// it, as a photograph's and a recording's are.
  siteVisitId String    @map("site_visit_id")
  siteVisit   SiteVisit @relation(fields: [siteVisitId], references: [id])

  /// The four stamps the state is read from, in the shape ADR-0034 gave a
  /// voice capture and for its reasons. There is no status column: ADR-0024
  /// made `resolved_at` the whole of *unresolved* and ADR-0031 made
  /// `closed_at` the whole of *closed*, so a second answer beside these would
  /// be a second thing to keep true.
  ///
  /// Queued is all of them null. `rendering_since` is stamped when the worker
  /// picks the job up; `storage_key` and `rendered_at` move together, as do
  /// `failed_at` and `failure`.
  ///
  /// Nothing clears them. A recording is retried in place because its audio is
  /// irreplaceable and the phone has already let go of it (ADR-0034); a report
  /// has no such input — every byte it needs is still in the database — so a
  /// second attempt is a second record and this row keeps saying what happened
  /// to the first.
  renderingSince DateTime? @map("rendering_since")
  renderedAt     DateTime? @map("rendered_at")

  /// Where the PDF is in the object store, and how big it is. Never on the
  /// wire, for the reason a photograph's key and a recording's are not: the
  /// key is the object store's business and means something different the day
  /// the adapter changes. The bytes come back through
  /// `GET /v1/site-visit-reports/:id/pdf`.
  ///
  /// There is no `content_type` beside them. A photograph and a recording each
  /// carry one because either could be one of several types; a report is
  /// always `application/pdf`, and a column holding one value forever is a
  /// place for it to one day hold another.
  storageKey String? @unique @map("storage_key")
  byteSize   Int?    @map("byte_size")

  /// Why it could not be rendered, bounded. Kept rather than cleared, because
  /// this row is the record of one attempt.
  failedAt DateTime? @map("failed_at")
  failure  String?

  /// When it was asked for. Entry order, so two reports generated in the same
  /// minute do not list at random, and the newest is the last of them.
  createdAt DateTime @map("created_at")

  @@index([siteVisitId, createdAt])
  @@map("site_visit_reports")
}

/// Which correspondence type a register logs (story 70).
///
/// A database enum, and the second one here — where the closed sets since
/// ADR-0024 have been text with a CHECK. That rule has a reason, and the
/// reason is absent here: `Physical / Safety` cannot be named as a Prisma enum
/// member, so an issue's category would have arrived on the wire as
/// `PHYSICAL_SAFETY` with the real words in a lookup beside it. `SUBMITTAL`
/// and `RFI` name themselves. `open_item_subject` is therefore the live
/// precedent — a set closed by what the product *is*, where adding a third
/// correspondence type is a migration rather than a string a caller invents.
///
/// Singular, because it names what an entry is and not what the log is
/// called: a screen writes "the RFIs register" out of `RFI`, the way it writes
/// "Floor 3" out of `3` (ADR-0030).
enum RegisterKind {
  SUBMITTAL
  RFI

  @@map("register_kind")
}

/// The log of one correspondence type on one job (glossary, story 70).
///
/// Two rows per project and exactly two, written in the same transaction as
/// the project itself. There is no create route and no delete: which
/// correspondence types exist is a fact about the product rather than a choice
/// about a job, so asking an engineer to make a submittals register before
/// logging a submittal would be a step with no decision in it. A phase is the
/// opposite case and is created by hand for that reason (ADR-0026).
///
/// The register carries no state of its own. It is a scope — the thing an
/// entry's number is unique within — and everything anybody reads off it is
/// its entries.
model Register {
  id String @id @default(uuid())

  projectId String  @map("project_id")
  project   Project @relation(fields: [projectId], references: [id])

  kind RegisterKind

  /// Entry order. The same instant as the project's, since both are written by
  /// the one call from the one injected TimeSource.
  createdAt DateTime @map("created_at")

  entries RegisterEntry[]

  /// One register of each kind per job, which is the whole of "a submittals
  /// register and an RFIs register per project" — held by the database rather
  /// than by the route that writes them.
  @@unique([projectId, kind])
  @@map("registers")
}

/// One piece of correspondence in a register: a submittal under review, or an
/// RFI awaiting an answer (issue #14).
///
/// It owns what it is *about* — the number it is filed under, its subject, the
/// parties, an RFI's question and answer — and owns nothing about whose move
/// it is. That is the handoff history underneath it, and the current holder is
/// derived from the last row of it on every read, the shape ADR-0027 gave
/// *currently provisional* and ADR-0028 gave *superseded*.
///
/// There is deliberately no status column, for the fourth record running
/// (ADR-0024, ADR-0031, ADR-0034, ADR-0035). The clock and the disposition
/// arrived in issue #15 as `turnaround_days`, `disposition` and `disposed_at`,
/// and no status column came with them: whose move it is is still the last
/// handoff and *past its clock* is still an arithmetic over the history.
model RegisterEntry {
  id String @id @default(uuid())

  registerId String   @map("register_id")
  register   Register @relation(fields: [registerId], references: [id])

  /// What the entry is filed under — "RFI-012", "23 05 93-1.1". Free text and
  /// the engineer's, not allocated: these numbers come off the contractor's
  /// transmittal and the job's own conventions, so a sequence of ours would be
  /// a second identifier for a thing that already has one. That is the
  /// opposite of an issue's number (ADR-0031), which exists precisely because
  /// a finding arrives with none.
  ///
  /// Capped at the revision's 32, being the other short designation (as
  /// `FLOOR` is). Unique within the register, so the same number may be both
  /// a submittal and an RFI on one job and never twice in one log.
  number String

  /// The one line that says what it is about. Capped at the project name's
  /// 200: it is a subject line, and the substance of an RFI is `question`.
  subject String

  /// Who it came from and who it is directed to — "Acme Mechanical", "the
  /// architect". Both free text capped at 120, matching an open item's
  /// `waiting_on` and a submission's `recipient`: ADR-0012 removed roles as
  /// identity, and the corpus closes exactly two sets, neither of them this.
  ///
  /// The fixed cast of the entry, and not whose move it is: the ball moves
  /// back and forth between them and out to a third party, which is what the
  /// handoff history records and these two columns must not be read as.
  fromParty String @map("from_party")
  toParty   String @map("to_party")

  /// What was asked, and what was answered (story 78). Both null on a
  /// submittal; on an RFI the question arrives with the row and the response
  /// lands later, through a route that refuses a second one.
  ///
  /// Which of the two kinds may carry them is enforced at the boundary and not
  /// by a CHECK, unlike the one-axis rule (ADR-0030) and the category
  /// (ADR-0031): the kind lives on the register, and a CHECK cannot read
  /// another row. Copying `kind` down here to make one possible would be the
  /// second place the same fact lives that this schema refuses everywhere
  /// else. The one invariant a CHECK *can* reach is written in the migration:
  /// a response without a question is impossible.
  question String?
  response String?

  /// The issuance that answered this entry, if one has (story 81, story 35).
  ///
  /// The arrow points this way and not from the submission, which the two
  /// stories together could be read as asking for. A column on `submissions`
  /// would have to be written after the set went out, and there is no route
  /// that updates a submission — a fact ADR-0026 made true by construction and
  /// a test asserts. Story 35 reads through this same column in reverse.
  submissionId String?     @map("submission_id")
  submission   Submission? @relation(fields: [submissionId], references: [id], onDelete: Restrict)

  /// The contractual turnaround, in whole days (story 73).
  ///
  /// A **duration and never a date**: it is the number the contract names, and
  /// the day it falls due is a function of it and of when the ball reached us,
  /// which the handoff history already holds. The glossary strikes *due date*
  /// under RFI for the same reason. Named for its unit rather than the PRD
  /// sketch's `turnaround_target`, which says nothing about what it is measured
  /// in.
  ///
  /// Null is the ordinary state of an entry nobody has put a number on, and
  /// such an entry is never past its clock — there is nothing to be past.
  /// Set once and never edited; a CHECK keeps it positive.
  turnaroundDays Int? @map("turnaround_days")

  /// The closed-set outcome of a submittal review, and the day it was reached
  /// (stories 75, 76).
  ///
  /// Text with a CHECK naming the five and never a database enum, which
  /// ADR-0036 decided in advance and ADR-0031 reasoned: `Approved as Noted`,
  /// `Revise and Resubmit` and `For Record Only` cannot be Prisma enum members,
  /// so an enum would put `APPROVED_AS_NOTED` on the wire with the real words
  /// in a lookup in the API and again in the frontend. One string is stored,
  /// sent, selected and printed.
  ///
  /// Both null or both set, the shape ADR-0024 gave resolution and ADR-0031
  /// gave a close. Which kind may carry one is the register's fact and so is
  /// the boundary's, exactly as `question` and `response` are.
  ///
  /// Recording one does not stop the clock by being written: it stops because
  /// the same call hands the ball back, and accrual reads the handoffs. There
  /// is no `clock_started` and no `clock_stopped`, though the PRD sketch names
  /// the first — either would be a second place a fact the history already
  /// holds could live, and disagree with it.
  disposition String?
  disposedAt  DateTime? @map("disposed_at")

  /// The round this entry follows, where a Revise and Resubmit brought one
  /// back (story 77).
  ///
  /// Unique, which is the whole of "at most one next round" and makes the chain
  /// linear — ADR-0028's `supersedes_id` exactly, and for its reason: the
  /// successor is created already pointing backwards and nothing ever repoints
  /// it, so a cycle cannot arise and the round it follows is never written to.
  previousRoundId String?        @unique @map("previous_round_id")
  previousRound   RegisterEntry? @relation("Rounds", fields: [previousRoundId], references: [id], onDelete: Restrict)
  nextRound       RegisterEntry? @relation("Rounds")

  /// Entry order, so two entries logged in the same minute do not list at
  /// random.
  createdAt DateTime @map("created_at")

  handoffs  BallInCourtEvent[]
  openItems RegisterEntryOpenItem[]

  /// The document versions this piece of correspondence arrived with, or was
  /// answered by (story 97). The `register_entry_open_items` shape exactly.
  documentVersions RegisterEntryDocumentVersion[]

  /// The extraction whose confirmation wrote this entry, if one did (issue
  /// #20). Unique from the extraction's side: an extraction commits at most
  /// one entry.
  extraction RegisterEntryExtraction?

  @@unique([registerId, number])
  @@index([registerId, createdAt])
  @@map("register_entries")
}

/// One handoff: from this moment, the ball is in the named party's court
/// (stories 71, 80).
///
/// A history and not a column, which the PRD settled on 2026-08-24 and gave
/// the reason for: the clock accrues only while the ball is ours, so elapsed
/// in-court time is computable *only* from the sequence. A single
/// `ball_in_court` field makes turnaround unauditable in exactly the dispute
/// it exists to settle.
///
/// This is the transition log ADR-0031 refused for an issue, and it is here
/// for the reason that refusal names. A finding's history was already the
/// sightings, so a status trail would have been a second record of the same
/// thing; nothing else here records whose move it was when. The test that it
/// has not become the `tasks` record by the back door is that the entry above
/// still has **no status column**: whose move it is now is read off the last
/// of these rows and stored nowhere.
model BallInCourtEvent {
  id String @id @default(uuid())

  registerEntryId String        @map("register_entry_id")
  entry           RegisterEntry @relation(fields: [registerEntryId], references: [id])

  /// Who holds it — "Acme Mechanical", "the architect", "us". Free text
  /// capped at 120, matching every other party in the product.
  party String

  /// Whether that party is us. The second fact, and not one derived from the
  /// first: issue #15 sums the intervals where this is true, and reading it
  /// off the name would make the product's central number a string comparison
  /// against a value the engineer typed — where ADR-0024 could reserve the
  /// word `nobody` because nothing counts on it. A job that calls us by the
  /// firm's name still accrues.
  inOurCourt Boolean @map("in_our_court")

  /// From when. Settable, because handoffs are entered from a transmittal log
  /// after the fact; otherwise the injected TimeSource, and never a database
  /// default (ADR-0022 names this slice).
  ///
  /// `since` and not `at`, matching an open item's `waiting_since`: the row is
  /// the start of an interval that the next row ends, which is the shape
  /// issue #15's accrual reads.
  heldSince DateTime @map("held_since")

  /// Entry order, and the tie-break when two handoffs carry the same instant —
  /// so "who holds it now" is total rather than arbitrary.
  createdAt DateTime @map("created_at")

  @@index([registerEntryId, heldSince])
  @@map("ball_in_court_events")
}

/// An open item being chased for a register entry (story 79).
///
/// A join, not a subject — the third record to be asked and the third to
/// answer the same way (ADR-0026, ADR-0031). The item's `subject_type` stays
/// `PROJECT` and its `subject_id` stays the job, so "cannot review this until
/// the load data arrives" reaches the pending items view carrying the job it
/// is on. Nothing in that view changed to make this work, which is the sign
/// the shape is right.
model RegisterEntryOpenItem {
  registerEntryId String        @map("register_entry_id")
  entry           RegisterEntry @relation(fields: [registerEntryId], references: [id])

  openItemId String   @map("open_item_id")
  openItem   OpenItem @relation(fields: [openItemId], references: [id])

  @@id([registerEntryId, openItemId])
  @@index([openItemId])
  @@map("register_entry_open_items")
}

/// A document stored against a job, and — where it is a **referenced file** —
/// deliberately not parsed (issue #17, stories 94-97).
///
/// This row is the **identity**, not the file: the title the job knows it by
/// and whether it is a referenced file, and nothing that changes from one
/// version to the next. It is the scope a version's `revision` is unique
/// within, which is what `Register` is to an entry's `number` (ADR-0036), and
/// it carries no state at all.
///
/// The bytes are on `DocumentVersion` and never here, so a document that has
/// been reissued three times is one record with three versions rather than
/// three records that could disagree about what the document *is*. That is
/// the departure from ADR-0028's `supersedes_id` chain and ADR-0035's
/// another-row-every-time, and the reason for it: those records share nothing
/// between links, and this one shares its whole identity.
///
/// [[PRD and Architecture]]'s data model sketch names three tables —
/// `documents`, `document_versions`, `referenced_files`. The third is refused
/// here, as `clock_started` was (ADR-0037) and the sketch's summary column
/// was (ADR-0031): [[glossary]] defines a referenced file as *a document*
/// stored and linked but deliberately not parsed, so a second table would
/// make one document two records and give "is this one?" two answers that
/// could differ.
model Document {
  id String @id @default(uuid())

  projectId String  @map("project_id")
  project   Project @relation(fields: [projectId], references: [id])

  /// What the job calls it — "Electrical drawing set", "Division 26
  /// specification". ADR-0008's `title`, entered by hand, which that ADR's
  /// own consequence names as the path a failed extraction degrades to.
  ///
  /// Not unique on a project. Two sets really can be called the same thing,
  /// and a constraint here would refuse the second rather than the mistake.
  /// Capped at the project name's 200.
  title String
  /// Whether this is stored and linked but **deliberately not parsed** — a
  /// drawing set, a spec book. An 86-sheet 48"x36" set is not an extraction
  /// target ([[glossary]]), and pretending otherwise is how a document
  /// pipeline becomes a liability.
  ///
  /// Required in the body that records the document and never edited
  /// afterwards, the shape `issued_provisional` has. A default would classify
  /// by omission, and the omitted answer would be the dangerous one: between
  /// recording and marking, a large-format set would be a target.
  ///
  /// A boolean and not a `document_type` enum, though ADR-0008 names one
  /// (drawing / spec / other). What this ticket asks about a document is the
  /// one thing that changes what may be done to it; a discipline and a type
  /// are extraction's fields and are not entered here (ADR-0019: nothing is
  /// stored that nothing reads).
  referencedFile Boolean @map("referenced_file")

  /// Entry order, so two documents stored in the same minute do not list at
  /// random.
  createdAt DateTime @map("created_at")

  versions DocumentVersion[]

  @@index([projectId, createdAt])
  @@map("documents")
}

/// One immutable revision of a document, in object storage ([[glossary]]:
/// *Document version*).
///
/// **Nothing edits one and nothing deletes one.** A newer revision is a new
/// row; the row it follows is not touched, which is what makes "which version
/// did we issue against" answerable years later — ADR-0028's reissue and
/// ADR-0035's re-render arriving for a third record, and ADR-0008's "the
/// original file in S3 is immutable" made structural.
///
/// The bytes are **not here**. They go to the injected `ObjectStore` and this
/// row keeps the key, which is the ticket's own criterion and the third record
/// to use that port after a photograph (ADR-0032) and a recording (ADR-0034).
model DocumentVersion {
  id String @id @default(uuid())

  documentId String   @map("document_id")
  document   Document @relation(fields: [documentId], references: [id])

  /// The designation printed on the sheet — "C", "Rev 2", "Addendum 1".
  ///
  /// ADR-0008's extracted field `revision`, entered by hand. The engineer's
  /// and never allocated, which is a register entry's `number` (ADR-0036) and
  /// the opposite of an issue's identifier (ADR-0031): a drawing set arrives
  /// stamped, and a sequence of ours would be a second name for something
  /// that already has one.
  ///
  /// Unique within its document, which is the whole of "a new version never
  /// overwrites a prior one" — held by the database rather than by a guard.
  /// [[glossary]]'s **Revision** strikes *version* as a synonym for a
  /// submission's revision; that entry is about an issuance, and this column
  /// carries the word the sheet does. Capped at the submission revision's 32,
  /// being the same kind of short designation.
  revision String

  /// The name the file arrived with, kept verbatim.
  ///
  /// Bookkeeping here and not the mechanism it is on a photograph
  /// (ADR-0032): a document is reached through the structure it belongs to,
  /// so nothing is parsed out of this. It is what the engineer recognises in
  /// a list.
  filename String

  /// One of the document types the boundary admits, held so the bytes can be
  /// served back as what they are. A CHECK names the set, since the read
  /// route hands this straight to a browser.
  contentType String @map("content_type")

  /// What was stored, so a list can be rendered without reading every object.
  byteSize Int @map("byte_size")

  /// Where the bytes are in the object store. Never on the wire, and stored
  /// rather than derived from the id, so the S3 adapter can key its objects
  /// however it likes.
  storageKey String @unique @map("storage_key")

  /// When this version was recorded. Entry order and not the date printed on
  /// the sheet: the revision is what names it, and a date nothing reads would
  /// be a column to keep wrong.
  createdAt DateTime @map("created_at")

  submissions     SubmissionDocumentVersion[]
  registerEntries RegisterEntryDocumentVersion[]

  /// The extractions that read this version (issue #20).
  extractions RegisterEntryExtraction[]

  @@unique([documentId, revision])
  @@index([documentId, createdAt])
  @@map("document_versions")
}

/// What a submission's sheet list points at (story 95).
///
/// The `submission_open_items` shape: a row written **after** the issuance,
/// which writes nothing to the submission and therefore does not edit one —
/// the property ADR-0026 made true by construction and ADR-0028 leaned on.
///
/// It points at a **version** and not at a document, which is what makes
/// "which version did we issue against" answerable. It does **not** point at
/// a *sheet*: ADR-0026 and [[glossary]] both price linking to one line of the
/// sheet list as a migration off that text column, and nothing in this ticket
/// addresses a single sheet.
///
/// Many-to-many, as `submission_open_items` is: one drawing set backs several
/// issuances, and one issuance's defined set is drawings and specs together.
model SubmissionDocumentVersion {
  submissionId String     @map("submission_id")
  submission   Submission @relation(fields: [submissionId], references: [id])

  documentVersionId String          @map("document_version_id")
  documentVersion   DocumentVersion @relation(fields: [documentVersionId], references: [id])

  @@id([submissionId, documentVersionId])
  @@index([documentVersionId])
  @@map("submission_document_versions")
}

/// What a register entry arrived with, or was answered by (story 97).
///
/// The same shape as the join above and as `register_entry_open_items`, and
/// here for the same reason: retrieval is by identity, so a submittal package
/// is found through the entry it was logged as, never by remembering the
/// filename.
model RegisterEntryDocumentVersion {
  registerEntryId String        @map("register_entry_id")
  entry           RegisterEntry @relation(fields: [registerEntryId], references: [id])

  documentVersionId String          @map("document_version_id")
  documentVersion   DocumentVersion @relation(fields: [documentVersionId], references: [id])

  @@id([registerEntryId, documentVersionId])
  @@index([documentVersionId])
  @@map("register_entry_document_versions")
}

/// One state of a project's **memory** — the curated prose holding reasoning
/// and decisions — with the whole history kept (issue #18, stories 98-103).
///
/// There is no `project_memories` identity row beside this, though
/// `documents`/`document_versions` has one. That split exists because a job
/// has many documents and the versions of one must be grouped under what they
/// are versions *of*; a project has exactly one memory, so the project is the
/// identity and a second table would be a row holding nothing but a foreign
/// key.
///
/// **Nothing edits a version and nothing deletes one.** An accepted proposal
/// or a direct write is a new row; the current memory is the latest, derived
/// on every read and stored nowhere — the shape ADR-0027 gave *currently
/// provisional*. That derivation is also why the columns are just the content
/// and the moment: everything else about a version is who proposed it, which
/// is the proposal's own record.
model ProjectMemoryVersion {
  id String @id @default(uuid())

  projectId String  @map("project_id")
  project   Project @relation(fields: [projectId], references: [id])

  /// The whole document, verbatim. Never trimmed, normalised or re-wrapped —
  /// ADR-0029's posture toward a captured block, applied to the engineer's
  /// own prose: a memory that came back re-wrapped would no longer be what
  /// anybody wrote.
  content String

  /// The proposal this version committed, if it came from one. Unique, which
  /// is the whole of "one proposal becomes at most one version": the accept
  /// route also refuses a resolved proposal, but a redelivered job and a
  /// double tap are both answered by the database rather than by a guard.
  ///
  /// `Restrict` named explicitly, because Prisma defaults an optional
  /// relation to `SetNull` while every foreign key in this schema is RESTRICT
  /// on delete but `projects.current_phase_id` — and left implicit, the next
  /// `migrate dev` rewrites it, which is how four of them were silently
  /// downgraded in slice 17 and restored here.
  proposalId String?         @unique @map("proposal_id")
  proposal   MemoryProposal? @relation(fields: [proposalId], references: [id], onDelete: Restrict)

  /// When this state of the memory was written. From the injected TimeSource
  /// and never a database default (ADR-0022). Also the ordering: two versions
  /// written in the same instant list by insertion, and the current one is
  /// the last.
  createdAt DateTime @map("created_at")

  @@index([projectId, createdAt])
  @@map("project_memory_versions")
}

/// An edit the agent proposed to a project's memory, awaiting the engineer
/// (issue #18, stories 99-100).
///
/// **The agent proposes; the human confirms.** The agent never writes memory
/// directly: its one mutating tool reaches only this table, and a proposal
/// becomes memory only through the accept route, which the agent has no tool
/// for. Every word in memory is there because the engineer put it there.
///
/// The state is two stamps and no status column — pending is both null,
/// resolved is one set — the shape ADR-0024 gave resolution, arrived at for
/// the fifth record. A proposal is never edited: the engineer's correction
/// lands as the *version's* content on accept, and this row keeps saying what
/// the agent actually proposed, which is what makes "the engineer changed it
/// before taking it" checkable afterwards.
model MemoryProposal {
  id String @id @default(uuid())

  projectId String  @map("project_id")
  project   Project @relation(fields: [projectId], references: [id])

  /// The run that produced it. Unique, which is the whole of "one run, at
  /// most one proposal" — an agent that called its tool twice in one run
  /// would otherwise write two drafts for one ask, and the second call is
  /// refused by the database rather than by a guard.
  runId String   @unique @map("run_id")
  run   AgentRun @relation(fields: [runId], references: [id])

  /// What the memory said when the proposal was written, or null when there
  /// was none — the base the proposal is a diff **against**. Stamped at the
  /// write rather than derived on read, because the memory may move while the
  /// proposal awaits its answer: a diff computed against today's content
  /// would silently change what was proposed the moment anything else
  /// committed. `submission_open_items.unresolved_at_issuance` is the same
  /// snapshot, for the same reason (ADR-0027).
  baseContent String? @map("base_content")

  /// The whole proposed document, verbatim, and never a diff column. The
  /// diff is derived on every read from this and `baseContent`, so the two
  /// cannot disagree — and storing the diff would leave nowhere to keep the
  /// full text an edit-before-accept starts from.
  proposed String

  /// Entry order, so two proposals from the same minute list in the order
  /// they arrived.
  createdAt DateTime @map("created_at")

  /// The resolution: both null while pending, exactly one set once the
  /// engineer has answered. Neither is ever cleared — a resolved proposal is
  /// part of the record, the way a report's failure is (ADR-0035).
  acceptedAt DateTime? @map("accepted_at")
  rejectedAt DateTime? @map("rejected_at")

  /// The version this proposal became, if it was accepted. The arrow points
  /// from the version, which writes nothing here — promotion's shape, for the
  /// fourth record (ADR-0031, ADR-0034).
  version ProjectMemoryVersion?

  @@index([projectId, createdAt])
  @@map("memory_proposals")
}

/// One execution of the agent against one project (issue #18, ADR-0002).
///
/// The glossary's **Agent run** is "a single execution within a session",
/// and this is that record — sanitised run metadata, kept, while the session
/// itself is in-memory and gone when the run ends. There is no `kind` column:
/// every run so far proposes a memory edit, and a column holding one value
/// forever is a place for it to one day hold another (ADR-0035). A second
/// kind of run is a migration, arriving with the work that needs it.
///
/// The state is the four stamps, derived on read, with no status column
/// beside them — queued is all four null, as it is for a report (ADR-0035).
/// A run is never retried in place: its every input is still in the database,
/// so asking again is another row, which is why there is no retry route and
/// nothing here is ever cleared.
model AgentRun {
  id String @id @default(uuid())

  projectId String  @map("project_id")
  project   Project @relation(fields: [projectId], references: [id])

  /// Stamped when the worker picks the job up. The proposal, if one comes,
  /// arrives *during* the run through the agent's tool.
  runningSince DateTime? @map("running_since")
  finishedAt   DateTime? @map("finished_at")

  /// Why the run could not finish, in the service's own words, bounded.
  failedAt DateTime? @map("failed_at")
  failure  String?

  /// When it was asked for. Entry order.
  createdAt DateTime @map("created_at")

  /// The proposal this run produced, if it produced one. Unique from the
  /// proposal's side — one run, at most one proposal.
  proposal MemoryProposal?

  @@index([projectId, createdAt])
  @@map("agent_runs")
}

/// One line of the append-only audit record (issue #18, story 106,
/// [[glossary]]: **Audit log**).
///
/// Every mutation of a project's memory writes one: a version written
/// directly, a proposal arriving, an accept, an accept-with-edit, a reject.
/// Nothing updates a row and nothing deletes one — there is no route that
/// touches this table but the writers, which is what "append-only" means
/// here by construction rather than by a guard.
///
/// This is the audit log the glossary defines and not the activity feed,
/// which is a separate stream the MVP does not build. The scope is memory,
/// because that is what this ticket's mutations are; widening it to every
/// record's mutations is its own change, not something to do row by row.
model AuditEntry {
  id String @id @default(uuid())

  projectId String  @map("project_id")
  project   Project @relation(fields: [projectId], references: [id])

  /// What happened — "memory written", "proposal accepted". Text rather than
  /// an enum: it is a sentence for a reader, and the set is closed by what
  /// the writers write rather than by the database.
  action String

  /// The particulars — how many characters were written, what a proposal was
  /// resolved to. Free text; the structured fact it describes is on the row
  /// it is about, and a reader comes here for the narrative.
  detail String

  /// When it happened, from the injected TimeSource and never a database
  /// default (ADR-0022). Also the order: an audit is read in the order it was
  /// written.
  createdAt DateTime @map("created_at")

  @@index([projectId, createdAt])
  @@map("audit_entries")
}

/// Where an arrival came from (issue #19, ADR-0042).
///
/// A database enum, following ADR-0036's `register_kind` rather than
/// ADR-0031's text-with-a-CHECK: both members name themselves and neither
/// contains a character a Prisma enum member cannot carry.
enum IngestSource {
  EMAIL
  MANUAL

  @@map("ingest_source")
}

/// A document that arrived from outside, before anything has read it
/// (issue #19, stories 84 and 93; [[glossary]]: **Ingest**).
///
/// This is deliberately NOT a `Document`. Three of that record's columns have
/// no answer at the moment a message lands: `referenced_file` is required with
/// no default because "a default classifies by omission" (ADR-0039), and
/// `revision` and the title are the engineer's and never allocated. Inventing
/// all three and calling them facts is exactly what ADR-0039 refused. They are
/// extraction's to propose and the engineer's to confirm, which is issue #20 —
/// the shape ADR-0034 gave a voice capture, where committing writes an
/// ordinary observation rather than the draft having been one all along.
///
/// Nothing here is parsed, extracted, indexed or summarised. No route reads
/// the body, no job name exists and nothing is enqueued by an arrival, which
/// is what makes story 89 true by construction rather than by a guard.
model IngestedDocument {
  id String @id @default(uuid())

  projectId String  @map("project_id")
  project   Project @relation(fields: [projectId], references: [id])

  /// The mail path or the fallback. Manual entry produces this same record.
  source IngestSource

  /// When it reached us, from the injected TimeSource and never a database
  /// default (ADR-0022).
  ///
  /// The message carries a `Date` header and it is NOT read. This answers the
  /// opposite way to `photos.taken_at` and `voice_captures.recorded_at`, which
  /// are both supplied so a delayed upload is not misdated — and the
  /// difference is the sender. A photograph's timestamp comes from the
  /// engineer's own camera; an email's comes from whoever sent it, and a
  /// header an untrusted party controls is not a timestamp this product will
  /// run a clock against (ADR-0042).
  arrivedAt DateTime @map("arrived_at")

  /// The envelope, stored verbatim and never interpreted. All four are null on
  /// the manual path, which is what makes it the same record shape rather than
  /// a second one; a CHECK holds the mail path to supplying the first two.
  sender    String?
  recipient String?
  subject   String?

  /// What the message said. Untrusted text kept exactly as it arrived —
  /// nothing trims it, normalises it or re-wraps it, the posture ADR-0029 took
  /// toward a captured block and ADR-0034 toward a transcript.
  body String?

  /// A line the engineer typed when entering one by hand. Null on the mail
  /// path: there is nobody to type it.
  note String?

  files IngestedDocumentFile[]

  @@index([projectId, arrivedAt])
  @@map("ingested_documents")
}

/// One file carried by an arrival (issue #19).
///
/// Called a *file* and never an attachment: that word is struck by three of
/// [[glossary]]'s `_Avoid_` lists — **Document**, **Photo** and **Referenced
/// file** — and ADR-0032 already enforced it once. The ticket's own wording is
/// not the vocabulary (ADR-0042).
model IngestedDocumentFile {
  id String @id @default(uuid())

  ingestedDocumentId String           @map("ingested_document_id")
  ingestedDocument   IngestedDocument @relation(fields: [ingestedDocumentId], references: [id])

  /// The name it arrived with. Untrusted, stored as data, and never used to
  /// build a path: the bytes go under a generated key.
  filename String

  /// What the sender *claimed* it is. Free text and deliberately not
  /// ADR-0039's closed set of three: refusing a `.dwg` would lose the record,
  /// which is the one thing story 93's fallback exists to prevent.
  ///
  /// The hole a free type would open — ADR-0039's "a row carrying `text/html`
  /// would be a page this product served under its own origin" — is closed at
  /// the read instead. The bytes route answers `application/octet-stream`
  /// always and never echoes this value into a header (ADR-0042).
  contentType String @map("content_type")

  byteSize Int @map("byte_size")

  /// Where the bytes are. Written to the store BEFORE this row and never
  /// inside a transaction with it (ADR-0032's order). NOT NULL, because no
  /// queue sits between the row and the file. Never reaches the wire.
  storageKey String @unique @map("storage_key")

  createdAt DateTime @map("created_at")

  /// The extractions that read this file (issue #20). Nothing deletes a
  /// file, so the relation is RESTRICT like every other here.
  extractions RegisterEntryExtraction[]

  @@index([ingestedDocumentId, createdAt])
  @@map("ingested_document_files")
}

/// One extraction: a queued run over one untrusted source that proposes the
/// typed fields of a register entry, and the engineer's answer to that
/// proposal (issue #20, stories 84-90; ADR-0043).
///
/// One table carries the run, the proposal and the resolution, and there is
/// deliberately **no status column**: queued, running, finished, failed,
/// pending, confirmed and rejected are derived on every read from the stamps
/// below — the fifth record asked for a status and the fifth to refuse
/// (ADR-0024, ADR-0031, ADR-0034, ADR-0035). `agent_runs` was not reused,
/// because it has no kind column and a memory screen reading it per project
/// could not keep an extraction run out of its list; a separate proposals
/// table was not split off, because nothing here wants the memory split's
/// reasons — there is no base to snapshot and no second record the proposal
/// becomes a key of.
///
/// **Nothing edits an extraction and nothing deletes one.** A second run over
/// the same source is another row — there is no retry route, ADR-0035's
/// reason: every input is still in the database.
model RegisterEntryExtraction {
  id String @id @default(uuid())

  projectId String  @map("project_id")
  project   Project @relation(fields: [projectId], references: [id])

  /// What was read: exactly one of the two, held by a CHECK in the
  /// migration. **One file of an arrival** — OCR reads a file and the review
  /// screen shows a file, so the source is file-level rather than
  /// arrival-level. **One version of a document** — a version is immutable,
  /// so the row records what was read and a later revision cannot move the
  /// record underneath it (ADR-0039's reason for versions existing).
  ingestedDocumentFileId String?               @map("ingested_document_file_id")
  ingestedDocumentFile   IngestedDocumentFile? @relation(fields: [ingestedDocumentFileId], references: [id], onDelete: Restrict)
  documentVersionId      String?               @map("document_version_id")
  documentVersion        DocumentVersion?      @relation(fields: [documentVersionId], references: [id], onDelete: Restrict)

  /// What the OCR step read, stored for audit (ADR-0008) and never rewritten:
  /// the engineer's correction happens at confirmation, and both facts are
  /// kept — ADR-0034's transcript posture for a third record. Also what the
  /// confirmation screen reviews against (ADR-0043).
  ocrText String? @map("ocr_text")

  /// The run's stamps. Queued is all four null; the proposal, if one comes,
  /// arrives *during* the run through the agent's `extraction_propose` tool
  /// calling the internal API.
  runningSince DateTime? @map("running_since")
  finishedAt   DateTime? @map("finished_at")

  /// Why the run could not finish, in the OCR provider's or the agent
  /// service's own words, bounded.
  failedAt DateTime? @map("failed_at")
  failure  String?

  /// When the proposal landed, and what it proposed: the register entry's
  /// fields, plus on the arrival path the document's title and revision —
  /// the two fields ADR-0042 named as extraction's to propose. All null
  /// until proposed; a run that finished without proposing is the honest
  /// "the agent found no correspondence here".
  proposedKind            RegisterKind? @map("proposed_kind")
  proposedAt              DateTime?     @map("proposed_at")
  proposedNumber          String?       @map("proposed_number")
  proposedSubject         String?       @map("proposed_subject")
  proposedFromParty       String?       @map("proposed_from_party")
  proposedToParty         String?       @map("proposed_to_party")
  proposedQuestion        String?       @map("proposed_question")
  proposedResponse        String?       @map("proposed_response")
  proposedTurnaroundDays  Int?          @map("proposed_turnaround_days")
  proposedParty           String?       @map("proposed_party")
  proposedInOurCourt      Boolean?      @map("proposed_in_our_court")
  proposedHeldSince       DateTime?     @map("proposed_held_since")
  proposedTitle           String?       @map("proposed_title")
  proposedRevision        String?       @map("proposed_revision")

  /// The resolution. Confirming writes the document (arrival path), the
  /// register entry with its first handoff, and the link between them in one
  /// transaction, and stamps both columns here; rejecting stamps the one.
  /// Exactly one of the three is ever set — a second answer is refused, as a
  /// response and a disposition are.
  confirmedAt     DateTime?      @map("confirmed_at")
  registerEntryId String?        @unique @map("register_entry_id")
  registerEntry   RegisterEntry? @relation(fields: [registerEntryId], references: [id], onDelete: Restrict)
  rejectedAt      DateTime?      @map("rejected_at")

  /// When it was asked for. Entry order.
  createdAt DateTime @map("created_at")

  @@index([projectId, createdAt])
  @@map("register_entry_extractions")
}
