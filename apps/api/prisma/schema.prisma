generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// The record everything else in this product hangs off (issue #3). There is
/// no owner, no tenant and no user: see ADR-0012.
///
/// Neither timestamp has a `@default(now())`. The database must not be able to
/// supply a domain-meaningful time, so that the value can only come from the
/// injected TimeSource at the API boundary (ADR-0022).
model Project {
  id String @id @default(uuid())

  /// The short local identifier — "T-1" — carried into the vault, into
  /// conversation and into email so one job is referred to the same way
  /// everywhere. Unique, and nothing writes it after creation: the API
  /// exposes no route that updates a project.
  projectNumber String @unique @map("project_number")

  name      String
  createdAt DateTime @map("created_at")

  /// When the job finished. Null is the live state; archiving stamps it once
  /// and never restamps, so the record survives and drops out of the list
  /// without being deleted. There is no unarchive.
  archivedAt DateTime? @map("archived_at")

  /// The phase a new submission defaults to (issue #5). This is the first
  /// column any route updates on a project; the project *number* is what the
  /// glossary makes immutable, and it still is (ADR-0026).
  currentPhaseId String?       @map("current_phase_id")
  currentPhase   ProjectPhase? @relation("CurrentPhase", fields: [currentPhaseId], references: [id])

  /// How many issue identifiers this project has handed out (issue #10).
  ///
  /// A high-water mark and never a count of the rows: it only ever increases,
  /// so a number is handed out once and never again — not after an issue is
  /// closed, and not after one is deleted, which `MAX(number) + 1` could not
  /// promise. That is the whole of story 59, and the reason a reference
  /// printed in an issued report stays valid forever.
  issuesAllocated Int @default(0) @map("issues_allocated")

  phases      ProjectPhase[] @relation("ProjectPhases")
  submissions Submission[]
  siteVisits  SiteVisit[]
  issues      Issue[]

  @@map("projects")
}

/// A named stage of design progress, defined per project and editable as free
/// text — "50% CD", "90% CD", "Building Permit Set" (ADR-0015, glossary).
///
/// Rows on a project and never an enum: some jobs run 50% CD and others go
/// straight to 90% CD, so there is no set to share across them.
model ProjectPhase {
  id String @id @default(uuid())

  projectId String  @map("project_id")
  project   Project @relation("ProjectPhases", fields: [projectId], references: [id])

  name String

  /// Contiguous from zero. Reordering rewrites the whole list in one
  /// transaction, so the route is the only writer and positions cannot drift
  /// into gaps or duplicates. Deliberately not a unique constraint: a
  /// non-deferrable one would reject the reorder mid-flight (ADR-0026).
  position Int

  submissions Submission[]
  currentFor  Project[]    @relation("CurrentPhase")

  @@unique([projectId, name])
  @@index([projectId, position])
  @@map("project_phases")
}

/// A dated issuance of a defined set to a named recipient at a phase
/// (ADR-0015, issue #5).
///
/// Never edited. There is no route that updates one, which is what makes
/// issue #7's "no path edits an issued submission" true by construction
/// rather than by a guard that can be forgotten. A correction is a reissue
/// that supersedes, and `supersedes_id` arrives with it.
model Submission {
  id String @id @default(uuid())

  projectId String  @map("project_id")
  project   Project @relation(fields: [projectId], references: [id])

  /// A foreign key, not a copied string: renaming a phase is the same body of
  /// work under a better name, so it propagates to what was issued at it. A
  /// different stage is a different phase (ADR-0026).
  phaseId String       @map("phase_id")
  phase   ProjectPhase @relation(fields: [phaseId], references: [id])

  /// When the set went out. Settable, because the issuances worth entering
  /// first went out long before this row existed; otherwise the injected
  /// TimeSource, and never a database default (ADR-0022).
  issuedAt DateTime @map("issued_at")

  /// Who it went to, and in what capacity — "the EOR", "the client". Both
  /// free text: there is no `users` table (ADR-0012), and the corpus names
  /// two example roles rather than a closed set.
  recipient     String
  recipientRole String @map("recipient_role")

  /// What distinguishes successive issuances of the same set: "A", "Rev 2".
  revision String

  /// The defined set, one sheet per line. Text rather than rows — ADR-0026
  /// records what that buys and the one thing it defers.
  sheetList String @map("sheet_list")

  /// Entry order, so two sets issued on the same day do not list at random.
  createdAt DateTime @map("created_at")

  /// Whether the set went out on unconfirmed inputs — true when any open item
  /// it was issued resting on was unresolved at that moment (issue #6).
  ///
  /// Stamped once by the create route and never recomputed: resolving those
  /// items afterwards answers the inputs, it does not change what the set
  /// went out on. *Currently* provisional is the other fact, derived from
  /// `openItems` on every read and never stored — a single column would have
  /// to lie about one of the two the moment an item resolved.
  ///
  /// No `@default`, for the reason the timestamps have none: only the route
  /// may supply it, or a caller could claim a set went out clean.
  issuedProvisional Boolean @map("issued_provisional")

  /// The issuance this one replaces (issue #7). Correcting the record is a
  /// reissue that supersedes, never an edit, so the arrow points backwards
  /// from the successor and the row it points at is not touched.
  ///
  /// Unique, which is the whole of "at most one successor": a second reissue
  /// of the same predecessor is refused by the database rather than by a
  /// guard that can be forgotten, and the chain is therefore linear. Cycles
  /// cannot arise — a row is created already pointing at an older one, and
  /// nothing ever repoints it.
  ///
  /// *Superseded* has no column. It is a successor existing, derived on every
  /// read, for the reason `currently provisional` is derived (ADR-0027): a
  /// stored flag would be a second place for the same fact to be wrong.
  supersedesId String?     @unique @map("supersedes_id")
  supersedes   Submission? @relation("Supersede", fields: [supersedesId], references: [id])
  supersededBy Submission? @relation("Supersede")

  openItems         SubmissionOpenItem[]
  assumptionRecords AssumptionRecord[]

  @@index([projectId, issuedAt])
  @@map("submissions")
}

/// What an issuance rests on (ADR-0026).
///
/// An open item's own `subject_type`/`subject_id` says where it lives; this
/// says which issuances depended on it. They are different relations, and
/// this one is many-to-many: one unconfirmed input that several sets went
/// out on is a single record, not one copy per set that rested on it.
///
/// `unresolved_at_issuance` is issue #6's snapshot of what was unresolved at
/// that moment. Issue #7's carry-forward is an insert against the successor,
/// which leaves the superseded submission's rows untouched — the reason this
/// is a join table and not a second subject.
model SubmissionOpenItem {
  submissionId String     @map("submission_id")
  submission   Submission @relation(fields: [submissionId], references: [id])

  openItemId String   @map("open_item_id")
  openItem   OpenItem @relation(fields: [openItemId], references: [id])

  /// Where this item stood at the moment the set went out (issue #6). Null is
  /// an item attached afterwards, which was no part of the issuance and is
  /// therefore the only kind that may be detached again — deleting a row of
  /// the snapshot would be the erasure by cleanup ADR-0026 flagged.
  unresolvedAtIssuance Boolean? @map("unresolved_at_issuance")

  @@id([submissionId, openItemId])
  @@index([openItemId])
  @@map("submission_open_items")
}

/// The set of artifacts an open item can hang off. ADR-0014 says "any
/// artifact"; only projects exist so far, so this carries one value and
/// adding a second is a migration rather than a new free-text string.
enum OpenItemSubject {
  PROJECT

  @@map("open_item_subject")
}

/// The central record of the product (ADR-0014, issue #4): an unresolved
/// dependency attached to an artifact.
///
/// "Pending items" is a *view* over these rows, never a second table.
///
/// The subject is polymorphic — type plus id — so there is no foreign key to
/// `projects`; the route checks the subject exists before writing.
model OpenItem {
  id String @id @default(uuid())

  subjectType OpenItemSubject @map("subject_type")
  subjectId   String          @map("subject_id")

  /// What is unresolved. The PRD's data-model sketch has no column for it,
  /// but ADR-0014 and the glossary both make it the first thing an open item
  /// records, so it is named here for the spec's own word.
  unresolved String

  /// What it blocks — the reason this is worth chasing.
  blocks String

  /// Who owes the next move. Null is nobody, which ADR-0014 calls out as a
  /// real answer; the API rejects a blank one, so nobody is only ever said on
  /// purpose and never arrived at by leaving a field empty.
  waitingOn String? @map("waiting_on")

  /// Since when. Aged by the pending items view, so it comes from the
  /// injected TimeSource or from the engineer backdating an item that has
  /// been open for months — never from a database default (ADR-0022).
  waitingSince DateTime @map("waiting_since")

  /// The event that makes a recorded result false without anything being
  /// unresolved. A field, not its own record type (glossary, ADR-0014).
  invalidationTrigger String? @map("invalidation_trigger")

  /// What changes if the assumption turns out wrong. Required: the glossary
  /// calls it the field that carries the engineering value.
  counterfactual String

  /// The internal person the item sits with — the author, or an E1 on the
  /// occasional delegated task. Plain text: there is no `users` table
  /// (ADR-0012), and this is a different person from `waitingOn`.
  owner String?

  /// Resolution is these two together: both null while unresolved, both set
  /// once resolved, and reopening clears both. Exposure and provisional state
  /// (issues #6, #16) are derived from `resolvedAt` being null.
  resolvedAt     DateTime? @map("resolved_at")
  resolutionNote String?   @map("resolution_note")

  /// The issuances resting on this item. Not the subject — see ADR-0026.
  submissions SubmissionOpenItem[]

  /// The `FLAGS / VERIFY` line this item was raised from, if it was raised
  /// from one at all (issue #8). Most open items are typed by hand and have
  /// none.
  raisedFrom RaisedFlag?

  /// The findings this item is being chased for (issue #10). Not the subject —
  /// see ADR-0026, and the same reasoning as `submissions` above.
  issues IssueOpenItem[]

  @@index([subjectType, subjectId])
  @@map("open_items")
}

/// The durable artifact of engineering reasoning (issue #8, glossary): the
/// `ASSUMPTIONS` block and the `FLAGS / VERIFY` block captured verbatim from a
/// helper skill's output, bound to the submission they justified, with the
/// code edition and the date.
///
/// The arithmetic is reproducible without this; the reasoning is not. Nothing
/// here reimplements a helper skill's math — this records what one produced.
///
/// Never edited, for the reason a submission is not: it is a capture of what
/// something else output at a moment. Running the calculation again produces
/// another record against the submission, dated its own day, and the two sit
/// side by side.
model AssumptionRecord {
  id String @id @default(uuid())

  /// The issuance this reasoning justified. A foreign key and not a
  /// polymorphic subject: the glossary binds an assumption record to a
  /// submission and to nothing else. The sketch in the PRD has no such column
  /// at all, which is one of the things ADR-0029 settles.
  submissionId String     @map("submission_id")
  submission   Submission @relation(fields: [submissionId], references: [id])

  /// The two blocks, verbatim. Held as text with nothing trimmed, normalised
  /// or re-wrapped: "captured verbatim" is the whole point, and a block that
  /// came back re-indented would no longer be what the helper skill produced.
  ///
  /// Each carries one entry per line — an assumed input, or a flag to verify.
  /// That is not a format this parses for: it is how the entries are
  /// addressed, and a line that is neither is simply a line nothing points at.
  assumptions String
  flags       String

  /// Which editions the reasoning was done against — "NEC 2023", or the five
  /// standards the generator sizer works to at once. One free-text field
  /// rather than a set: it is a list an engineer writes, and it cannot be read
  /// out of the blocks, which never name it.
  codeEdition String @map("code_edition")

  /// The date of the calculation this captures — the sketch's "dated".
  /// Settable, because the reasoning worth entering first was done long
  /// before this row existed; otherwise the injected TimeSource, and never a
  /// database default (ADR-0022).
  calculatedAt DateTime @map("calculated_at")

  /// Entry order, so two captures dated the same day do not list at random.
  createdAt DateTime @map("created_at")

  counterfactuals Counterfactual[]
  raisedFlags     RaisedFlag[]

  @@index([submissionId, calculatedAt])
  @@map("assumption_records")
}

/// What changes if one assumed input turns out wrong (story 39, glossary).
///
/// The sketch in the PRD names `counterfactuals` as a column. It is rows,
/// because the spec asks for one per assumed input and a single field could
/// not say which input each belongs to.
///
/// The input is a *line number*, not a copy of the text. The block is captured
/// verbatim and never edited, so the line is a stable pointer, and there is
/// therefore only one place the wording of an assumption can be wrong.
model Counterfactual {
  assumptionRecordId String           @map("assumption_record_id")
  assumptionRecord   AssumptionRecord @relation(fields: [assumptionRecordId], references: [id])

  /// Zero-based index into the lines of `assumption_records.assumptions`.
  line Int

  /// Capped at 1000 like the open item's, being the same field on the other
  /// record the glossary requires it on.
  counterfactual String

  @@id([assumptionRecordId, line])
  @@map("counterfactuals")
}

/// A line of a record's `FLAGS / VERIFY` block that has been raised as an open
/// item (issue #8, story 40), so a flag raised during a calculation cannot be
/// raised and then forgotten.
///
/// Addressed by line for the reason a counterfactual is.
///
/// A flag has no state of its own. It is outstanding until it is raised, and
/// after that the open item's `resolved_at` is the whole of whether it is
/// still outstanding — ADR-0024's one column, not a second beside it.
model RaisedFlag {
  assumptionRecordId String           @map("assumption_record_id")
  assumptionRecord   AssumptionRecord @relation(fields: [assumptionRecordId], references: [id])

  /// Zero-based index into the lines of `assumption_records.flags`.
  line Int

  /// The item this flag became. Unique, which is the whole of "one flag, at
  /// most one open item, and no item is two flags": raising the same flag
  /// twice is refused by the database rather than by a guard that can be
  /// forgotten.
  openItemId String   @unique @map("open_item_id")
  openItem   OpenItem @relation(fields: [openItemId], references: [id])

  @@id([assumptionRecordId, line])
  @@map("raised_flags")
}

/// One dated observation event against a building (issue #9, glossary): a walk,
/// with a start, an end, and a per-floor schedule of when each floor was
/// started and completed.
///
/// It produces observations; it does not own their content. Where an
/// observation was made is the observation's own location, and this record
/// says only when the engineer was where.
///
/// Not an *inspection*: the glossary's `_Avoid_` list strikes that word because
/// it implies an authority-having-jurisdiction role that is not ours, and
/// strikes *walkthrough* with it. "Walk" is what the act is called in prose;
/// the record is a site visit.
model SiteVisit {
  id String @id @default(uuid())

  projectId String  @map("project_id")
  project   Project @relation(fields: [projectId], references: [id])

  /// When the walk began. Settable, because the visits worth entering first
  /// happened long before this row existed; otherwise the injected TimeSource,
  /// and never a database default (ADR-0022).
  startedAt DateTime @map("started_at")

  /// When it ended, or null while it is still under way. Nullable because the
  /// per-floor schedule is recorded *during* the visit (story 50), so a walk
  /// has to be able to exist before it is over — `POST /v1/site-visits/:id/end`
  /// stamps it once and refuses a second time.
  ///
  /// The visit's **date** is the day of `started_at`, derived on every read and
  /// stored nowhere. A `visited_on` column would be a second place for the same
  /// fact to be wrong (ADR-0027's shape, applied here).
  endedAt DateTime? @map("ended_at")

  /// Entry order, so two visits started the same day do not list at random.
  createdAt DateTime @map("created_at")

  floors       SiteVisitFloor[]
  observations Observation[]
  photos       Photo[]

  @@index([projectId, startedAt])
  @@map("site_visits")
}

/// One floor's entry in a visit's schedule: when it was started and when it was
/// completed (story 50).
///
/// This exists so that every photo taken between those two stamps can be
/// attributed to that floor without each one being labelled by hand (issue #11).
/// That is the whole of its job — it is a window in time, not a location.
///
/// One row per floor per visit. Starting the same floor twice on one walk is
/// refused by the unique constraint rather than by a guard that can be
/// forgotten, which is the shape `supersedes_id` and `raised_flags.open_item_id`
/// already have.
model SiteVisitFloor {
  id String @id @default(uuid())

  siteVisitId String    @map("site_visit_id")
  siteVisit   SiteVisit @relation(fields: [siteVisitId], references: [id])

  /// The floor designation, without the word "Floor" — "3", "B1", "M", "PH".
  /// Free text and not an integer: the grammar writes `Floor N`, but real
  /// buildings have basements, mezzanines and penthouses, and an integer column
  /// could not record an observation made in any of them (ADR-0030).
  ///
  /// The same type as `observations.floor`, deliberately, so a later slice can
  /// bin a photo to a floor and find the observations made on it.
  floor String

  /// When the engineer arrived on this floor, and when they left it. The
  /// completion is null while the floor is still being walked.
  startedAt   DateTime  @map("started_at")
  completedAt DateTime? @map("completed_at")

  @@unique([siteVisitId, floor])
  @@map("site_visit_floors")
}

/// Something recorded during a site visit at a specific location and time
/// (issue #9, glossary).
///
/// **Most observations are not findings.** The "Notable Observations
/// (Non-Issues)" table is the majority case, so staying an observation is the
/// default path and there is nothing on this row that makes one a finding.
/// Becoming an **issue** is ticket #10's deliberate exception, and it arrives as
/// a row pointing at this one rather than as a status column here.
///
/// Bound to the visit that produced it and to nothing else. The project is the
/// visit's, read through it, for the reason an assumption record reads its
/// project through its submission.
model Observation {
  id String @id @default(uuid())

  siteVisitId String    @map("site_visit_id")
  siteVisit   SiteVisit @relation(fields: [siteVisitId], references: [id])

  /// What was observed. Named for the domain word the way an open item's
  /// `unresolved` is, and deliberately not `note`: the glossary's `_Avoid_`
  /// list strikes that word for this record, because a note is something you
  /// jot beside a thing and this *is* the thing.
  observed String

  /// When it was observed. Settable, and otherwise the injected TimeSource:
  /// this is the stamp issue #11 bins photographs against, so it must be the
  /// real moment and never the moment the row was written.
  observedAt DateTime @map("observed_at")

  /// The location, stored as the components of the grammar rather than as the
  /// composed string: `Floor N — <qualifier>, <Side|Sector>` (glossary).
  ///
  /// The rendered string is derived on every read and stored nowhere, so the
  /// components and the string cannot come to disagree — the shape ADR-0027 and
  /// ADR-0028 gave *currently provisional* and *superseded*.
  ///
  /// The qualifier is free text on purpose: the glossary admits five kinds of
  /// reference — a landmark, a room number with a type gloss, a circulation
  /// element, a program space, or an equipment tag — and a column that could
  /// hold only one of them would force the field to match the tool.
  floor     String
  qualifier String

  /// Side (A/B, the building halves) and Sector (a finer zone) are independent
  /// axes and **never combine in one string**. Exactly one is set: both is
  /// refused, and neither is refused too, because the grammar has no optional
  /// segment for the interface to leave empty (story 55, ADR-0030).
  ///
  /// Enforced by a CHECK constraint in the migration as well as by the route.
  /// Prisma's schema language cannot express one, so it is written by hand
  /// there and named here; three more routes will write this table (#10's
  /// re-observation, #12's draft from a transcript) and each of them would
  /// otherwise have to remember.
  side   String?
  sector String?

  /// Entry order, so two observations at the same minute do not list at random.
  createdAt DateTime @map("created_at")

  /// The findings this observation is one sighting of (issue #10). Nothing
  /// here says whether there are any: promotion is a row pointing back at this
  /// one, which is what keeps staying an observation the default path.
  issues IssueObservation[]

  @@index([siteVisitId, observedAt])
  @@map("observations")
}

/// A project-scoped **finding** with a stable identifier that survives the
/// report it first appeared in (issue #10, glossary).
///
/// This is the record the five findings of 2026-07-23 never had: written up
/// with recommended actions, and nothing tracking whether any of them closed.
///
/// It owns no content of its own. What was seen, when and where is the
/// observation's, and an issue re-observed on three walks has three of them —
/// so there is no summary column here and no location, which the PRD's sketch
/// named. Story 67 prints "the issues with their categories, locations": the
/// location is read through the observations, the way an assumption record
/// reads its project through its submission.
///
/// *Finding* is the right word for it and for nothing else. The glossary's
/// `_Avoid_` list reserves the word for an observation that has become an
/// issue, and strikes *defect*, *deficiency*, *punch item* and *RFI* — only a
/// minority of issues ever become RFIs.
model Issue {
  id String @id @default(uuid())

  projectId String  @map("project_id")
  project   Project @relation(fields: [projectId], references: [id])

  /// The stable identifier, scoped to the project and allocated from
  /// `projects.issues_allocated` at creation (stories 58, 59).
  ///
  /// The integer and nothing else. How it prints in a report is issue #13's
  /// and how it appears in a photograph's filename is issue #11's, and neither
  /// has seen the real filenames yet — inventing `T-1-003` here would be a
  /// format those tickets then have to match rather than choose.
  ///
  /// Unique per project, which is what makes "never renumbered" a fact the
  /// database keeps rather than a guard that can be forgotten. No route
  /// updates it: there is no PATCH on an issue at all.
  number Int

  /// One of exactly five, in the words the glossary writes them:
  /// `Accessibility`, `Physical / Safety`, `Functional`, `Safety / Code`,
  /// `Design / Coordination` (story 60).
  ///
  /// Text with a CHECK constraint rather than a database enum, because a
  /// Prisma enum member cannot be named `Physical / Safety` and would put a
  /// `PHYSICAL_SAFETY` on the wire with the real words in a lookup beside it —
  /// the second place the same fact lives that ADR-0024 refuses. The closed
  /// set is enforced by the body schema *and* by the CHECK, the shape
  /// ADR-0030 gave the one-axis rule; the constraint is written by hand in the
  /// migration, since Prisma's schema language cannot express one.
  category String

  /// The lifecycle the five findings never had: both null while the issue is
  /// open, both set once it is closed, and reopening clears both.
  ///
  /// ADR-0024's shape exactly, and for its reasons: a status column would be a
  /// second place the same fact lives, and there is no history of closings
  /// because the observations are the history — "still there on the second
  /// walk" is a re-observation row, not a state transition (story 61).
  closedAt    DateTime? @map("closed_at")
  closureNote String?   @map("closure_note")

  /// Entry order, so two issues raised on the same walk do not list at random.
  createdAt DateTime @map("created_at")

  observations IssueObservation[]
  openItems    IssueOpenItem[]
  photos       Photo[]

  @@unique([projectId, number])
  @@map("issues")
}

/// One sighting of a finding: the observation it was raised from, and every
/// later observation of the same thing (story 61).
///
/// A row pointing at the observation and never a column on it. ADR-0030 is
/// explicit that becoming an issue "will arrive as a row pointing at the
/// observation, not as a column here", and a test asserts the exact key set an
/// observation returns — so the shape is `raised_flags`', which is a row for
/// the same reason.
model IssueObservation {
  issueId String @map("issue_id")
  issue   Issue  @relation(fields: [issueId], references: [id])

  /// Unique, which is the whole of "one observation, at most one issue": the
  /// database refuses a second promotion of the same sighting rather than a
  /// guard that can be forgotten, exactly as `raised_flags.open_item_id` and
  /// `submissions.supersedes_id` do.
  ///
  /// It matters more here than there. Identifiers are never reused, so a
  /// double-tap that promoted twice would burn a number on a duplicate and
  /// leave the record permanently one issue heavier.
  ///
  /// Two problems seen in one place are two observations, not one observation
  /// on two findings.
  observationId String      @unique @map("observation_id")
  observation   Observation @relation(fields: [observationId], references: [id])

  @@id([issueId, observationId])
  @@map("issue_observations")
}

/// An open item being chased for a finding (story 69).
///
/// A join, not a subject. The item's `subject_type` stays `PROJECT` and its
/// `subject_id` stays the job, so it is on the project screen and reaches the
/// pending items view carrying the job it is on — which is what story 69 asks
/// for and what ADR-0026 recorded the subject reading would cost.
model IssueOpenItem {
  issueId String @map("issue_id")
  issue   Issue  @relation(fields: [issueId], references: [id])

  openItemId String   @map("open_item_id")
  openItem   OpenItem @relation(fields: [openItemId], references: [id])

  @@id([issueId, openItemId])
  @@index([openItemId])
  @@map("issue_open_items")
}

/// A photograph taken on a walk, bound to a floor by its timestamp and to a
/// finding by its filename (issue #11).
///
/// The bytes are **not here**. They go to the injected `ObjectStore` and this
/// row keeps the key, which is the ticket's own acceptance criterion and what
/// makes the same port serve issue #12's audio and step 5's documents.
///
/// Both bindings are stamped when the photograph is added and both are
/// correctable. Deliberately not derived on read, which is what this product
/// does with `location`, *currently provisional* and *superseded*: a derived
/// value has nowhere to keep a correction, and a schedule fixed the next
/// morning would silently move what was already binned.
model Photo {
  id String @id @default(uuid())

  /// The walk it was taken on, the way an observation is bound to its visit
  /// and to nothing else. The project is the visit's.
  siteVisitId String    @map("site_visit_id")
  siteVisit   SiteVisit @relation(fields: [siteVisitId], references: [id])

  /// The name the file arrived with, kept verbatim.
  ///
  /// Record content and not bookkeeping: the filename **is** the mechanism
  /// that binds a photograph to a finding (ADR-0018's "already in use"), so it
  /// is the one column here that a correction must never rewrite.
  ///
  /// Unique per visit, so re-adding the same hundred photographs after a
  /// signal drop is refused one at a time instead of doubling the walk.
  filename String

  /// When the photograph was taken, supplied by whoever adds it.
  ///
  /// Required, and pointedly **not** falling back to the injected TimeSource
  /// the way `observed_at` does: a photograph with no time would then bin to
  /// whichever floor was being walked at the moment of the request, which is
  /// the guess the ticket asks not to make. Nothing here reads EXIF — the
  /// product records the timestamp it is given.
  takenAt DateTime @map("taken_at")

  /// One of the image types the boundary admits, held so the bytes can be
  /// served back as what they are. A CHECK names the set, since the read route
  /// hands this straight to a browser.
  contentType String @map("content_type")

  /// What was stored, so a list can be rendered without reading every object.
  byteSize Int @map("byte_size")

  /// Where the bytes are in the object store. Stored rather than derived from
  /// the id, so the S3 adapter can key its objects however it likes without
  /// this table meaning something different than it did.
  storageKey String @unique @map("storage_key")

  /// The floor the timestamp binned it to, or null for a photograph no single
  /// window contained.
  ///
  /// The designation and not a foreign key to `site_visit_floors`, matching
  /// `observations.floor`: ADR-0030 joined those two by value precisely so a
  /// photograph's floor could sit beside the observations made on it, and a
  /// correction has to be able to name a floor nobody formally started.
  floor String?

  /// The finding the filename bound it to, or null for a name that matched no
  /// issue on this job.
  ///
  /// Binding here writes nothing to the issue and creates no **sighting**: a
  /// sighting is an observation (ADR-0031), and a filename is not one.
  issueId String? @map("issue_id")
  issue   Issue?  @relation(fields: [issueId], references: [id])

  /// Entry order, so two photographs taken in the same minute do not list at
  /// random.
  createdAt DateTime @map("created_at")

  @@unique([siteVisitId, filename])
  @@index([siteVisitId, takenAt])
  @@index([issueId])
  @@map("photos")
}
