# Local development. `pnpm dev` copies this to .env if none exists.
DATABASE_URL=postgresql://epmos:epmos@localhost:5432/epmos
REDIS_URL=redis://localhost:6379
API_PORT=3001
# Where a photograph's bytes go. The local stand-in for S3 (ADR-0032).
OBJECT_STORE_DIR=.object-store

# There is **no secret to configure** since issue #105: the gate in front of
# every route is a session belonging to a person (ADR-0055), and a deployment's
# first account is made on the machine with
#
#     pnpm --filter api user create "Your Name" you@example.com
#
# which is also how any account's password is reset (`user reset <email>`) and how a closed
# account is re-opened (`user enable <email>`).

# Which transcription adapter runs (ADR-0034, ADR-0061). Unset is the honest
# default: every voice capture fails with "no transcription vendor is
# configured", the audio stays in the store and the retry route is there. An
# unrecognised name lands here too — a misspelled vendor refuses rather than
# being guessed at.
#
# `azure` is Azure AI Speech **fast transcription** (ADR-0061) and needs the two
# strings below. Fast and not batch: batch reads audio from a blob URL and there
# is no object storage here.
#
# `stub` returns one fixed, self-describing line whatever it is given. It is
# there so the draft review screen can be exercised before a vendor exists, and
# it must never be set on a real walk.
# TRANSCRIBER=stub
# TRANSCRIBER=azure
# AZURE_SPEECH_ENDPOINT=https://<resource>.cognitiveservices.azure.com
# AZURE_SPEECH_KEY=

# Which agent adapter runs the memory proposals (issue #18, ADR-0040). Unset
# is the honest default: every run fails with "no model provider is
# configured", which is the path a development run should see while there is
# no provider credential. `pi` builds the real adapter; the provider key is
# the Pi SDK's own (its auth store or the environment) and stays server-side.
# AGENT=pi
# Which model every run uses, as <provider>/<model>, required with AGENT=pi:
# the process refuses to start without it, and a run fails rather than use a
# model nobody named (issue #157, ADR-0065).
# AGENT_MODEL=alibaba-plan/deepseek-v4.1-flash
# Where the per-project agent workspaces live. No file tool is enabled, so
# this directory stays empty; it is the session's `cwd` so that a built-in a
# future SDK default turns on would land there and not in the repository.
# AGENT_WORKSPACE_DIR=.agent-workspaces

# Which OCR adapter runs (ADR-0043, ADR-0060). Unset is the honest default:
# every extraction fails with "no OCR provider is configured", the source is
# exactly where it was and nothing left the process. An unrecognised name lands
# here too.
#
# `azure` is Azure AI Document Intelligence `prebuilt-read` (ADR-0060) and needs
# the two strings below. The document's bytes go up inline as base64 — there is
# no object storage here, which is what ruled out Textract and Google Document
# AI — and the result is deleted at the vendor once it has been read.
#
# `stub` returns one fixed invented page. It exists so the confirmation screen
# is reachable without spending a page count, and must never be pointed at a
# real document.
# OCR=stub
# OCR=azure
# AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=https://<resource>.cognitiveservices.azure.com
# AZURE_DOCUMENT_INTELLIGENCE_KEY=

# The inbound mail provider (issue #19, ADR-0042). No adapter is written: the
# default refuses, which is what keeps the employer-consent gate — a provider
# would hold the whole of every forwarded message. `stub` reads one documented
# normalised envelope and must never be pointed at a real mailbox.
# INBOUND_MAIL=stub

# The public half of a project's forward-to-ingest address. Unset means no
# address is offered, rather than a plausible one that receives nothing.
# INGEST_DOMAIN=ingest.example.com
