# Local development. `pnpm dev` copies this to .env if none exists.
DATABASE_URL=postgresql://epmos:epmos@localhost:5432/epmos
REDIS_URL=redis://localhost:6379
API_PORT=3001
# Where a photograph's bytes go. The local stand-in for S3 (ADR-0032).
OBJECT_STORE_DIR=.object-store

# Which transcription adapter runs (ADR-0034). Unset is the honest default:
# every voice capture fails with "no transcription vendor is configured", the
# audio stays in the store and the retry route is there — which is the path a
# development run should see while the vendor is still an open pick.
#
# `stub` returns one fixed, self-describing line whatever it is given. It is
# there so the draft review screen can be exercised before a vendor exists, and
# it must never be set on a real walk.
# TRANSCRIBER=stub
