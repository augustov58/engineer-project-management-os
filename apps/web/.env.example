# Local development. `pnpm dev` copies this to .env if none exists.
NEXT_PUBLIC_API_URL=http://127.0.0.1:3001

# The one shared secret in front of every route (ADR-0020), the same value the
# API is given. Deliberately not a `NEXT_PUBLIC_` name: that would inline it
# into every client bundle. The engineer presents it once at /unlock and the
# browser holds it in a cookie; the Next server presents it to the API.
EDGE_SECRET=development-only-not-a-secret
