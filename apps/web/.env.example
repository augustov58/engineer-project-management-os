# Local development. `pnpm dev` copies this to .env if none exists.
NEXT_PUBLIC_API_URL=http://127.0.0.1:3001

# And nothing else. The credential this app carries is the engineer's session,
# minted by the API when they sign in and held in an httpOnly cookie — never a
# value in this file, and never a `NEXT_PUBLIC_` name, which would inline it
# into every client bundle (issue #105, ADR-0055).
